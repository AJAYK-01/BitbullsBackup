  "<!DOCTYPE html>\n\n<html lang=\"en-US\"><!--<![endif]--><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width\" name=\"viewport\"/>\n<title>Umbrella Escrow</title>\n<link href=\"style.css\" id=\"twentytwelve-style-css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/>\n</head>\n<body class=\"home page page-id-7 page-template-default custom-background custom-font-enabled single-author\">\n<header class=\"site-header\" id=\"masthead\" role=\"banner\">\n<hgroup>\n<a href=\"index.html\">\n<img src=\"logo.png\" style=\"display: block; margin: 0 auto; opacity: 0.6;\"/>\n</a>\n</hgroup>\n</header><!-- #masthead -->\n<div class=\"hfeed site\" id=\"page\">\n<!-- <img src=\"lock-2.png\" style=\"margin-left: 85%; position: absolute; top: 135px; width: 70px\">  -->\n<img src=\"umbrella 3.png\" style=\"float: right; width: 200px; margin: 20px -40px 0 0; opacity: 0.2;\"/>\n<div class=\"wrapper\" id=\"main\">\n<div class=\"site-content\" id=\"primary\">\n<div class=\"left-button\">\n<a href=\"newescrow.html\"><p>Start new escrow</p></a>\n</div> <!-- left-button -->\n<div class=\"right-button\">\n<a href=\"existing.html\"><p>View existing escrow</p></a>\n</div> <!--right-button -->\n<div id=\"instructions\" style=\"letter-spacing: 1px; text decoration: underline; color: #444;margin-bottom: 30px;text-align: center;\">\n<ul>\n<li class=\"opening\">Instructions\r\n\t\t\t\t\t<ul>\n<li>\n<div style=\"position: absolute; width: 600px; color: #444; font-size: 14px; line-height: 1.5; background-color: mintcream; padding: 20px; box-shadow: 0px 3px 3px rgba(100, 100, 100, 0.3);; border-radius: 5px; z-index: 999;\">\n<ul>\n<li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">• </span><b>Seller</b> provide a <b>Buyer</b> with a BTC wallet</li>\n<li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">• </span><b>Buyer</b> starts an escrow session and transfers funds to an escrow account</li>\n<!-- <li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">&#8226; </span><b>Buyer</b> and <b>Seller</b> receive a confirmation by e-mail</li> -->\n<li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">• </span><b>Seller</b> provides a service or sends product(s)</li>\n<li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">• </span>Inspection perion begins when <b>Buyer</b> receives item(s)</li>\n<li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">• </span>After the inspection period expired, the funds are releasing to the <b>Seller</b> or a dispute is started</li>\n<li><span style=\"color: gold; text-shadow: 2px 2px 3px gray\">• </span>Funds can be released before inspection period is expired upon <b>Buyer's</b> request</li>\n</ul>\n</div>\n</li>\n</ul>\n</li>\n</ul>\n</div>\n</div>\n</div><!-- #primary -->\n<p style=\"color: red; text-align: center; width: 600px; border: 1px solid; margin: 0px auto; padding: 5px;\">Our link has been changed to <b>2hftxvyft7dl3fk2.onion</b>. Bookmark it!</p>\n</div><!-- #main .wrapper -->\n<footer id=\"colophon\" role=\"contentinfo\">\n<div class=\"navigation\">\n<table cellspacing=\"10\">\n<tr>\n<td><a href=\"escrow_process.html\">Escrow process</a></td>\n<td><a href=\"fees.html\">Fees</a></td>\n<td><a href=\"dispute_guide.html\">Dispute guide</a></td>\n<td><a href=\"affiliate_program.html\">Affiliate program</a></td>\n<td><a href=\"contact_us.html\">Contact us</a></td>\n</tr>\n</table>\n</div>\n<div class=\"site-info\">\n<p>Â© Copyright Umbrella Escrow 2014-2017.</p>\n</div><!-- .site-info -->\n<div class=\"embed_os\" style=\"\">\n<a href=\"http://4r4zaei5qa7qq5ha.onion#2hftxvyft7dl3fk2.onion\" target=\"_blank\"><img alt=\"\" src=\"http://4r4zaei5qa7qq5ha.onion/ratings/2hftxvyft7dl3fk2.onion.png\"/></a>\n</div>\n</footer><!-- #colophon -->\n</body></html><!-- #page -->\n\n",
