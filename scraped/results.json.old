  "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">\n <html> <head> <meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-type\"/> <link href=\"favicon.ico\" rel=\"icon\" type=\"image/icon\"/> <link href=\"favicon.ico\" rel=\"shortcut icon\" type=\"image/icon\"/> <title>The Hidden Wiki</title> <style type=\"text/css\">\rbody\r{background-color: #fff;\r\tbackground-image:url('data:image/png;base64,');\r\tfont-family: Arial,Helvetica,\"Helvetica Neue\",sans-serif;\r    font-size: 14px;\r    color: #666;\r    line-height: 20px;\r\tmargin:0;\r\tpadding:0;}\r\t\ra, a:visited { color: #444; outline: 0; text-decoration: none;\r\t\t\r\t\t-webkit-transition: all 0.2s linear;\r\t\t-moz-transition: all 0.2s linear;\r\t\t-ms-transition: all 0.2s linear;\r\t\t-o-transition: all 0.2s linear;\r\t\ttransition: all 0.2s linear;\t\t\t\r\t}\r\ta:hover, a:focus { color: #63A62F; }\r\r.floatimg\r{padding-bottom:5px; padding-right:20px;}\r\r.clear{clear: both;}\r\rh3{color:#333; font: bold 28px/1em HelveticaNeue, Arial, sans-serif; margin: 5px 0 20px 2px;}\r\r#header{\r\tbackground: #fff;\r\tposition:relative;\r}\r\r#logo {height:50px;width:300px;position:relative;padding:35px 0 20px;float:left;clear:both;}\r\r#cp {position:relative;top:50px;right:10px;font-size: 14px;font-weight:bold;float:right;}\r#cp span {padding: 10px;}\r\r#main{\r\twidth: 900px;\r\tmargin: 30px auto 20px;\r\tpadding: 0 40px;\r\ttext-align: left;\r\tbackground: white;\r\r\t-webkit-box-shadow: 0px 0px 10px rgba(0,0,0,0.1);\r\t-moz-box-shadow: 0px 0px 10px rgba(0,0,0,0.1);\r\tbox-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);\t\r\t\r\t-moz-border-radius: 5px;\r\t-webkit-border-radius: 5px;\r\t-khtml-border-radius: 5px;\r\tborder-radius: 5px;\r}\r\r#amenu\r{\r\tposition:relative;\r\tpadding-bottom: 20px;\r}\r\rul.menu > li > a .bubble{\r\tfont-size:11px;\r\tline-height:11px;\r\tpadding:1px 4px;\r\t-webkit-border-radius:3px;\r\t-moz-border-radius:3px;\r\tborder-radius:3px;\r\tmargin-left:5px;\r\tposition:relative;\r\ttop:-2px;\r\tcolor:#fff;\r\tbackground-color:#63A62F;\r\ttext-shadow:0 1px #032B4F;\r}\r\r#amenu ul.menu {\r\tlist-style: none;\r\tmargin: 0;\r\tpadding: 0;\r\tbackground: #393b3c url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAoCAIAAACw1AcgAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAACVJREFUeNpi9vT0ZGJgYMDA////R6GxiWGjsbGR+cTqgbIBAgwANEs88VP0f5wAAAAASUVORK5CYII=') top left repeat-x;\r\theight: 40px;\r\tpadding: 0px 0 0 5px;\r\tfont-weight: bold;\r\tfont-size: 15px;\r\t-moz-border-radius: 4px;\r    -webkit-border-radius: 4px;\r    -khtml-border-radius: 4px;\r    border-radius: 4px;\r}\r\r#amenu ul.menu a{\r\tfont-size: 15px;\t\r\ttext-decoration: none;}\r\r#amenu ul li {margin-bottom: 0;}\r#amenu ul li.wallet{float: right;}\r\r#amenu > ul > li {\r\tposition: relative;\r\tfloat: left;\r\tz-index: 1015;\r\tpadding: 0px 2px 0px 0px;\r\tbackground: url('main_nav_bgr_sep_dark.png') right top no-repeat;\t\r}\r\r#amenu > ul > li > a {\r\tcolor: #222;\r\ttext-shadow: 0px 1px 0px #fff;\r\tline-height: 40px;\r\ttext-decoration: none;\r\tdisplay: block;\r\tpadding: 0px 16px 0px 16px;\r\tz-index: 6;\r\tposition: relative;\r\tbackground: #393b3c url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAoCAIAAACw1AcgAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAACVJREFUeNpi9vT0ZGJgYMDA////R6GxiWGjsbGR+cTqgbIBAgwANEs88VP0f5wAAAAASUVORK5CYII=') top left repeat-x;\r\tcolor: #fff;\r\ttext-shadow: 0px 1px 0px #111;\r\t\r\t-webkit-transition: all 0.2s linear;\r\t-moz-transition: all 0.2s linear;\r\t-ms-transition: all 0.2s linear;\r\t-o-transition: all 0.2s linear;\r\ttransition: all 0.2s linear;\r}\r\r#amenu > ul > li > a:hover {\r\tbackground: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAoCAIAAAHH0ze2AAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAHFJREFUeNpiio1PYPr/7x/Tn39/mf7++cP05/cfgABiio2PZ/r7F8T/y/T7L1Dszx+AAGICq/v/H6z2H8N/pn9A+v9fIBsoBlILEv/77x9AgIHVMTAwgNUyANUx/Iew/wPZ/2FskBw