iv class=\"clearfix colelem\" id=\"u785-4\"><!-- content -->\n<p>Shipping Time</p>\n</div>\n<div class=\"clearfix colelem\" id=\"pu747\"><!-- group -->\n<div class=\"clip_frame grpelem\" id=\"u747\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"82\" id=\"u747_img\" src=\"images/europe.png?crc=469257034\" width=\"107\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u754\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"89\" id=\"u754_img\" src=\"images/n_america.png?crc=3824857519\" width=\"118\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u733\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"89\" id=\"u733_img\" src=\"images/asia.png?crc=3776980802\" width=\"115\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u725\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"89\" id=\"u725_img\" src=\"images/africa.png?crc=174482913\" width=\"97\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u761\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"97\" id=\"u761_img\" src=\"images/s_america.png?crc=4076010750\" width=\"68\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u740\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"91\" id=\"u740_img\" src=\"images/australia.png?crc=282526316\" width=\"99\"/>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"pu689-4\"><!-- group -->\n<div class=\"clearfix grpelem\" id=\"u689-4\"><!-- content -->\n<p>Europe</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u692-4\"><!-- content -->\n<p>North America</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u695-4\"><!-- content -->\n<p>Asia</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u704-4\"><!-- content -->\n<p>Africa</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u701-4\"><!-- content -->\n<p>South America</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u698-4\"><!-- content -->\n<p>Australia</p>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"pu707-4\"><!-- group -->\n<div class=\"clearfix grpelem\" id=\"u707-4\"><!-- content -->\n<p>4-5 days</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u710-4\"><!-- content -->\n<p>5-7 days</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u713-4\"><!-- content -->\n<p>5-6 days</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u719-4\"><!-- content -->\n<p>4-6 days</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u716-4\"><!-- content -->\n<p>5-7 days</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u722-4\"><!-- content -->\n<p>5-7 days</p>\n</div>\n</div>\n<div class=\"colelem\" id=\"u2646\"><!-- simple frame --></div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"grpelem\" id=\"u2643\"><!-- simple frame --></div>\n</div>\n<div class=\"browser_width colelem\" id=\"u788-bw\">\n<div id=\"u788\"><!-- column -->\n<div class=\"clearfix\" id=\"u788_align_to_page\">\n<div class=\"colelem\" id=\"u3092\"><!-- simple frame --></div>\n<div class=\"clearfix colelem\" id=\"u791-4\"><!-- content -->\n<p>Prepaid card Fullz</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u792-4\"><!-- content -->\n<p>If you do not want to buy a prepaid plastic card, then you can buy fresh and valid fullz that you can use for online shopping. Fullz look like this: 4867967032437155|123|1119|AliceAnt|Wall st. 767|New-York|12345|NY|US|email@email.com|123-123-123</p>\n</div>\n<div class=\"clearfix colelem\" id=\"pu813\"><!-- group -->\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u813\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u863\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"90\" id=\"u863_img\" src=\"images/fullz.png?crc=180434562\" width=\"147\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u810-4\"><!-- content -->\n<p>VISA Fullz $3000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u887-4\"><!-- content -->\n<p>$99</p>\n</div>\n</div>\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u822\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u873\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"90\" id=\"u873_img\" src=\"images/fullz.png?crc=180434562\" width=\"147\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u819-4\"><!-- content -->\n<p>Master Card Fullz $3000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u825-4\"><!-- content -->\n<p>$99</p>\n</div>\n</div>\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u854\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u880\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"90\" id=\"u880_img\" src=\"images/fullz.png?crc=180434562\" width=\"147\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u841-4\"><!-- content -->\n<p>American Express Fullz $3000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u860-4\"><!-- content -->\n<p>$99</p>\n</div>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"u3718-4\"><!-- content -->\n<p>contact us for purchase - millionaire.private.club@protonmail.com</p>\n</div>\n<div class=\"colelem\" id=\"u3095\"><!-- simple frame --></div>\n</div>\n</div>\n</div>\n<div class=\"browser_width colelem\" id=\"u890-bw\">\n<div id=\"u890\"><!-- column -->\n<div class=\"clearfix\" id=\"u890_align_to_page\">\n<div class=\"position_content\" id=\"u890_position_content\">\n<div class=\"colelem\" id=\"u3098\"><!-- simple frame --></div>\n<div class=\"clearfix colelem\" id=\"u893-4\"><!-- content -->\n<p>American Express Gift Cards</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u894-4\"><!-- content -->\n<p>The safest product in carding! Cards can be used virtually anywhere American Express is accepted in the WorldWide Gift Card funds do not expire, there are no fees after purchase.</p>\n</div>\n<div class=\"clearfix colelem\" id=\"pu1131\"><!-- group -->\n<div class=\"clip_frame grpelem\" id=\"u1131\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"45\" id=\"u1131_img\" src=\"images/money.png?crc=4175813334\" width=\"43\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u926\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"44\" id=\"u926_img\" src=\"images/earth.png?crc=132303236\" width=\"43\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u928\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"43\" id=\"u928_img\" src=\"images/safe.png?crc=14897079\" width=\"33\"/>\n</div>\n<div class=\"clip_frame grpelem\" id=\"u930\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"44\" id=\"u930_img\" src=\"images/shipping.png?crc=3884855908\" width=\"66\"/>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"pu906-4\"><!-- group -->\n<div class=\"clearfix grpelem\" id=\"u906-4\"><!-- content -->\n<p>Great balances!</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u911-4\"><!-- content -->\n<p>Cards work everywhere!</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u912-4\"><!-- content -->\n<p>It's safe!</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u913-4\"><!-- content -->\n<p>Free express delivery</p>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"pu907-4\"><!-- group -->\n<div class=\"clearfix grpelem\" id=\"u907-4\"><!-- content -->\n<p>Unlike other gift cards, American Express gift cards have a large balance of up to $ 3000</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u908-6\"><!-- content -->\n<p>You can use cards in stores and</p>\n<p>for online shopping.</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u909-4\"><!-- content -->\n<p>American Express gift cards look like a greeting or a bonus for work.</p>\n</div>\n<div class=\"clearfix grpelem\" id=\"u910-6\"><!-- content -->\n<p>Delivery is already included in the price! We ship orders worldwide via courier services</p>\n<p>(DHL, FedEx, etc.)</p>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"pu1017\"><!-- group -->\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u1017\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u1160\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"93\" id=\"u1160_img\" src=\"images/amexday.png?crc=209341196\" width=\"148\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u1020-4\"><!-- content -->\n<p>AMEX Gift Card $1000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u1022-4\"><!-- content -->\n<p>$90</p>\n</div>\n</div>\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u1018\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u1170\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"93\" id=\"u1170_img\" src=\"images/amexday.png?crc=209341196\" width=\"148\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u1024-4\"><!-- content -->\n<p>AMEX Gift Card $2000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u1021-4\"><!-- content -->\n<p>$169</p>\n</div>\n</div>\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u1019\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u1201\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"93\" id=\"u1201_img\" src=\"images/amexday.png?crc=209341196\" width=\"148\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u1025-4\"><!-- content -->\n<p>AMEX Gift Card $3000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u1023-4\"><!-- content -->\n<p>$249</p>\n</div>\n</div>\n</div>\n<div class=\"clearfix colelem\" id=\"pu1074\"><!-- group -->\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u1074\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u1177\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"93\" id=\"u1177_img\" src=\"images/amexbuisnes.png?crc=289641650\" width=\"148\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u1083-4\"><!-- content -->\n<p>AMEX Gift Card $1000</p>\n</div>\n<div class=\"clearfix colelem\" id=\"u1089-4\"><!-- content -->\n<p>$90</p>\n</div>\n</div>\n<div class=\"shadow rounded-corners clearfix grpelem\" id=\"u1077\"><!-- column -->\n<div class=\"clip_frame colelem\" id=\"u1187\"><!-- image -->\n<img alt=\"\" class=\"block\" height=\"93\" id=\"u1187_img\" src=\"images/amexbuisnes.png?crc=289641650\" width=\"148\"/>\n</div>\n<div class=\"clearfix colelem\" id=\"u1095-4\"><!-- conten