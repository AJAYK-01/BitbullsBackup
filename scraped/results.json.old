er-radius:3px;\r\tmargin-left:5px;\r\tposition:relative;\r\ttop:-2px;\r\tcolor:#fff;\r\tbackground-color:#63A62F;\r\ttext-shadow:0 1px #032B4F;\r}\r\r#amenu ul.menu {\r\tlist-style: none;\r\tmargin: 0;\r\tpadding: 0;\r\tbackground: #393b3c url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAoCAIAAACw1AcgAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAACVJREFUeNpi9vT0ZGJgYMDA////R6GxiWGjsbGR+cTqgbIBAgwANEs88VP0f5wAAAAASUVORK5CYII=') top left repeat-x;\r\theight: 40px;\r\tpadding: 0px 0 0 5px;\r\tfont-weight: bold;\r\tfont-size: 15px;\r\t-moz-border-radius: 4px;\r    -webkit-border-radius: 4px;\r    -khtml-border-radius: 4px;\r    border-radius: 4px;\r}\r\r#amenu ul.menu a{\r\tfont-size: 15px;\t\r\ttext-decoration: none;}\r\r#amenu ul li {margin-bottom: 0;}\r#amenu ul li.wallet{float: right;}\r\r#amenu > ul > li {\r\tposition: relative;\r\tfloat: left;\r\tz-index: 1015;\r\tpadding: 0px 2px 0px 0px;\r\tbackground: url('main_nav_bgr_sep_dark.png') right top no-repeat;\t\r}\r\r#amenu > ul > li > a {\r\tcolor: #222;\r\ttext-shadow: 0px 1px 0px #fff;\r\tline-height: 40px;\r\ttext-decoration: none;\r\tdisplay: block;\r\tpadding: 0px 16px 0px 16px;\r\tz-index: 6;\r\tposition: relative;\r\tbackground: #393b3c url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAoCAIAAACw1AcgAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAACVJREFUeNpi9vT0ZGJgYMDA////R6GxiWGjsbGR+cTqgbIBAgwANEs88VP0f5wAAAAASUVORK5CYII=') top left repeat-x;\r\tcolor: #fff;\r\ttext-shadow: 0px 1px 0px #111;\r\t\r\t-webkit-transition: all 0.2s linear;\r\t-moz-transition: all 0.2s linear;\r\t-ms-transition: all 0.2s linear;\r\t-o-transition: all 0.2s linear;\r\ttransition: all 0.2s linear;\r}\r\r#amenu > ul > li > a:hover {\r\tbackground: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAoCAIAAAHH0ze2AAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAHFJREFUeNpiio1PYPr/7x/Tn39/mf7++cP05/cfgABiio2PZ/r7F8T/y/T7L1Dszx+AAGICq/v/H6z2H8N/pn9A+v9fIBsoBlILEv/77x9AgIHVMTAwgNUyANUx/Iew/wPZ/2FskBw