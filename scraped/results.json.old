  "<!DOCTYPE html>\n<html><head>\n<title>Daniel - Tutorials</title>\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\"/>\n<meta content=\"Daniel Winzen\" name=\"author\"/>\n<meta content=\"width=device-width, initial-scale=1\" name=\"viewport\"/>\n</head><body>\n<div id=\"banner\"><h1>Tutorials</h1></div>\n<style type=\"text/css\">body{margin:0;font-size:16px}#banner{background:#0000FF;text-align:center}#banner h1{font-size: 24px;color:#FFFFFF;margin:0;padding:17px}#content{margin-left:170px;margin-bottom:30px;padding:5px 5px;word-wrap:break-word;min-height:100vh}#nav{position:absolute;margin-top:0px;padding:0;border:1px solid silver;background-color:#FFFFFF;text-align:left;width:160px}#nav li{list-style:none;margin:0;padding:10px}#nav a{display:block;font-weight:bold}#nav a:link{color:#000000;background-color:#EEEEEE}#nav a:visited{color:#666666;background-color:#EEEEEE}#nav a:hover{color:#000000;background-color:#FFFFFF}#nav a:active{color:#FFFFFF;background-color:#808080}#burger_check{display:none}.table{display:table;width:100%}.row{display:table-row}.cell{border: 1px solid #999999;display:table-cell;padding:3px 3px}.headerrow{display:table-header-group;font-weight:bold}@media (max-width: 768px){body{font-size:18px}#nav{display:none}.burger_nav .bar1,.burger_nav .bar2,.burger_nav .bar3{width: 35px;height: 5px;background-color: #333;margin: 6px 6px}#nav .burger_nav .bar1{transform: rotate(-45deg) translate(-9px, 6px)}#nav .burger_nav .bar2{opacity:0;}#nav .burger_nav .bar3 {transform: rotate(45deg) translate(-8px, -8px)}#content{margin-left:50px;margin-top:-30px}#burger_check:checked+#nav{display:block;left:0;top:0;width:100%;z-index:1}}</style><label class=\"burger_nav\" for=\"burger_check\"><div class=\"bar1\"></div><div class=\"bar2\"></div><div class=\"bar3\"></div></label><input id=\"burger_check\" type=\"checkbox\"/><ul id=\"nav\"><label class=\"burger_nav\" for=\"burger_check\"><div class=\"bar1\"></div><div class=\"bar2\"></div><div class=\"bar3\"></div></label><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/\">Home</a></li><li><a href=\"http://danschat356lctri3zavzh6fbxg2a7lo6z3etgkctzzpspewu7zdsaqd.onion\">Chat</a></li><li><a href=\"http://donionsixbjtiohce24abfgsffo2l4tk26qx464zylumgejukfq2vead.onion/test.php\">Online-Test</a></li><li><a href=\"http://donionsixbjtiohce24abfgsffo2l4tk26qx464zylumgejukfq2vead.onion/onions.php\">Onion link list</a></li><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/mail/index.php\">E-Mail + XMPP</a></li><li><a href=\"http://dhosting4xxoydyaivckq7tsmtgi4wfs3flpeyitekkmqwu4v4r46syd.onion\">Hosting</a></li><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/tutorials/index.php\">Tutorials</a></li><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/faq.php\">FAQ</a></li><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/about.php\">About</a></li><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/privacy.php\">Privacy policy</a></li><li><a href=\"http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/contact.php\">Contact</a></li></ul><div id=\"content\"><p>Here I upload tutorials that have been asked for a number of times. If you have suggestions on how to improve a tutorial or want me to make one another one, you can <a href=\"/contact.php\">contact me here</a>.</p>\n<div class=\"table\">\n<div class=\"headerrow\"><div class=\"cell\">Name</div><div class=\"cell\">Short description</div></div>\n<div class=\"row\"><div class=\"cell\"><a href=\"torchat/\">TorChat</a></div><div class=\"cell\">This tutorial will show you how to update TorChat's old Windows version.</div></div>\n<div class=\"row\"><div class=\"cell\"><a href=\"torify-ftp/\">Torify FTP clients</a></div><div class=\"cell\">This tutorial will show you how to torify FTP clients.</div></div>\n</div>\n</div>\n</body></html>\n",
  "Daniel - Tutorials",
  "http://danielas3rtn54uwmofdo3x2bsdifr47huasnmbgqzfrec5ubupvtpid.onion/tutorials/index.php"
]
