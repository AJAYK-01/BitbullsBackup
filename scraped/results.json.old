o-defer=\"\">window['pagespeed'] = window['pagespeed'] || {};var pagespeed = window['pagespeed'];pagespeed.switchToHighResAndMaybeBeacon = function(elem) {setTimeout(function(){elem.onload = null;var srcset = elem.getAttribute('data-pagespeed-high-res-srcset');if (srcset) {elem.srcset = srcset;}elem.src = elem.getAttribute('data-pagespeed-high-res-src');if (pagespeed.CriticalImages) {elem.onload = pagespeed.CriticalImages.checkImageForCriticality(elem);}}, 0);};</script><img alt=\"Whonix Desktop\" data-pagespeed-high-res-src=\"/w/images/6/6a/1000x540xWhonix-workstation.jpg.pagespeed.ic.5XSVQWtQN-.jpg\" data-pagespeed-high-res-srcset=\"/w/images/6/6a/1500x810xWhonix-workstation.jpg.pagespeed.ic.TYfYovFgay.jpg 1.5x,/w/images/6/6a/Whonix-workstation.jpg 2x\" height=\"540\" id=\"whonix-dekstop-pic\" onerror=\"this.onerror=null;pagespeed.switchToHighResAndMaybeBeacon(this);\" onload=\"pagespeed.switchToHighResAndMaybeBeacon(this);\" src=\"data:image/jpeg;base64,\" width=\"1000\"/>\n</a>\n</div>\n</section>\n<section id=\"download\">\n<div class=\"grid\">\n<div class=\"two-thirds\">\n<h2>Download, Install, Run <a class=\"freelink\" href=\"wiki/Why_Whonix_is_Freedom_Software\">FREE</a></h2>\n<p>\nWhonix <a href=\"wiki/Whonix_Trademark_Policy\" rel=\"noopener\" target=\"_blank\">™</a>\nisn't a program like most of your applications. It's a full\noperating system that runs inside your current one. Select which\noperating system your computer is running.\n</p>\n</div>\n</div>\n<div class=\"grid\">\n<a class=\"nofocuslink\" href=\"wiki/Windows_Quick_Start\">\n<div class=\"third\" id=\"win10\">\n<img alt=\"Download for Windows 10\" data-pagespeed-lazy-src=\"/w/images/e/ee/Windows_logo_-_2012.svg.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n<h4>Windows</h4>\n</div>\n</a>\n<a class=\"nofocuslink\" href=\"wiki/VirtualBox\">\n<div class=\"third\">\n<img alt=\"Download for Linux\" data-pagespeed-lazy-src=\"/w/images/a/af/Tux.png.pagespeed.ce.Jh5LK455op.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"108\"/>\n<h4>Linux</h4>\n<p>Run it with VirtualBox</p>\n</div>\n</a>\n<a class=\"nofocuslink\" href=\"wiki/MacOS\">\n<div class=\"third\">\n<img alt=\"Download for Mac\" data-pagespeed-lazy-src=\"/w/images/3/36/Macos_by_ego_no_background.png.pagespeed.ce.NdNGvU9byj.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n<h4>macOS</h4>\n<p>Run it with VirtualBox</p>\n</div>\n</a>\n<a class=\"nofocuslink\" href=\"wiki/Qubes\">\n<div class=\"third\">\n<img alt=\"Download for Qubes\" data-pagespeed-lazy-src=\"/w/images/9/94/128x128xQubes-logo-blue.png.pagespeed.ic.a6YF-Lpo5-.png\" data-pagespeed-lazy-srcset=\"/w/images/9/94/Qubes-logo-blue.png 1.5x\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n<h4>Qubes</h4>\n</div>\n</a>\n<a class=\"nofocuslink\" href=\"wiki/KVM\">\n<div class=\"third\">\n<img alt=\"Download for KVM\" data-pagespeed-lazy-src=\"/w/images/thumb/b/bb/Kvm.png/150px-Kvm.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n<h4>KVM</h4>\n<p>For those who prefer KVM over VirtualBox</p>\n</div>\n</a>\n</div>\n</section>\n<section class=\"grid\" id=\"the-press\">\n<div class=\"third\">\n<a href=\"https://wired.com\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Wired\" data-pagespeed-lazy-src=\"/w/images/e/e5/Wired.svg\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"352\"/>\n</a>\n<a href=\"https://www.wired.com/2014/06/be-anonymous-online\" rel=\"noopener\" target=\"_blank\">\n”For the even more paranoid, there is a lesser-known Tor-enabled OS\ncalled Whonix”\n</a>\n</div>\n<div class=\"third\">\n<a href=\"https://www.theguardian.com/technology/2015/mar/06/tips-tricks-anonymous-privacy\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"The Guardian\" data-pagespeed-lazy-src=\"/w/images/7/75/The_Guardian_2018.svg\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"352\"/>\n</a>\n<a href=\"https://www.theguardian.com/technology/2015/mar/06/tips-tricks-anonymous-privacy\" rel=\"noopener\" target=\"_blank\">\n”Whonix is about as anonymous as an OS can get before it all becomes\ntoo inconvenient for normal use.”\n</a>\n</div>\n<div class=\"third\">\n<a href=\"https://theintercept.com/2015/09/16/getting-hacked-doesnt-bad/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"The Intercept\" data-pagespeed-lazy-src=\"/w/images/1/14/The_Intercept_logo.svg\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"352\"/>\n</a>\n<a href=\"https://theintercept.com/2015/09/16/getting-hacked-doesnt-bad/\" rel=\"noopener\" target=\"_blank\">\n”Whonix, an operating system you can run in a virtual machine to maximize your online anonymity; it’s ideal for maintaining a secret identity.”\n</a>\n</div>\n<div class=\"third\">\n<a href=\"https://www.techrepublic.com/blog/smb-technologist/whonix-adds-a-layer-of-anonymity-to-your-business-tasks/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"TechRepublic\" data-pagespeed-lazy-src=\"/w/images/5/52/352x128xTechRepublic-ConvertImage.png.pagespeed.ic.RP03bRIxWc.png\" data-pagespeed-lazy-srcset=\"/w/images/5/52/TechRepublic-ConvertImage.png.pagespeed.ce.1tfXrCs3Pz.png 1.5x\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"352\"/>\n</a>\n<a href=\"https://www.techrepublic.com/blog/smb-technologist/whonix-adds-a-layer-of-anonymity-to-your-business-tasks/\">\n”Whonix adds a layer of anonymity to your business tasks.”\n</a>\n</div>\n<div class=\"third\">\n<a href=\"https://torproject.org\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"The Tor Project Logo\" data-pagespeed-lazy-src=\"/w/images/thumb/4/44/2880px-Tor-logo-2011-flat.svg.png/470px-2880px-Tor-logo-2011-flat.svg.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"212\"/>\n</a>\n<a href=\"https://blog.torproject.org/tor-heart-whonix\" rel=\"noopener\" target=\"_blank\">\n”Whonix is a privacy ecosystem that utilizes compartmentalization to\nprovide a private, leak-resistant environment for many desktop\ncomputing activities. Whonix helps users use their favorite desktop\napplications anonymously.”\n</a>\n<p>The Tor\n<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a> Project\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://twitter.com/Snowden\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Edward Snowden\" data-pagespeed-lazy-src=\"/w/images/2/20/128x128xExpert-edward-snowden.jpg.pagespeed.ic.BDK3y0NsaB.jpg\" data-pagespeed-lazy-srcset=\"/w/images/2/20/192x192xExpert-edward-snowden.jpg.pagespeed.ic.w0mq9NkcP4.jpg 1.5x,/w/images/2/20/xExpert-edward-snowden.jpg.pagespeed.ic.OdIjmSWa9j.jpg 2x\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n</a>\n<a href=\"https://twitter.com/Snowden/status/1165607338973130752\" rel=\"noopener\" target=\"_blank\">\n”I use Qubes and a Whonix gateway literally everyday”\n</a>\n<p>\nEdward Snowden, whistleblower, privacy advocate,\n<a href=\"https://freedom.press/people/edward-snowden/\" rel=\"noopener\" target=\"_blank\">president of the Freedom of the Press Foundation board</a>\n<a href=\"https://twitter.com/Snowden/status/1165607338973130752\" rel=\"noopener\" target=\"_blank\">[1]</a>\n<a href=\"https://twitter.com/Snowden/status/1175435436501667840\" rel=\"noopener\" target=\"_blank\">[2]</a>\n<a href=\"https://twitter.com/Snowden/status/781495273726025728\" rel=\"noopener\" target=\"_blank\">[3]</a>\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://linuxsecurity.com\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"LinuxSecurity.com Logo\" data-pagespeed-lazy-src=\"https://www.whonix.org/w/images/5/51/LinuxSecuri-KC52a-A06.jpg\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n</a>\n<a href=\"https://linuxsecurity.com/features/features/7-best-linux-distros-for-security-and-privacy-in-2020\" rel=\"noopener\" target=\"_blank\">\n”This split design allows the user to remain completely anonymous and mitigates the risk of DNS leaks, which reveal private information such as your web browsing history.”\n</a>\n<p>LinuxSecurity.com</p>\n</div>\n</section>\n<section class=\"tbb\" id=\"tbb\">\n<div class=\"app-display app-display--horizontal\">\n<div class=\"app-display__description\">\n<h2>\nAll activity in a virtual machine, all internet traffic through the\nTor<a class=\"nofocuslink\" href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a>\nnetwork\n</h2>\n<p>\nWhonix is the best way to use\nTor<a class=\"nofocuslink\" href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a>\nand provides the strongest protection of your IP address.\n</p>\n</div>\n<img alt=\"Tor Browser with duckduckgo\" class=\"app-display__image\" data-pagespeed-lazy-src=\"/w/images/1/11/1016x555xTor_browser_duckduckgo2.jpg.pagespeed.ic.3aXnWmTMzJ.jpg\" data-pagespeed-lazy-srcset=\"/w/images/1/11/1524x832xTor_browser_duckduckgo2.jpg.pagespeed.ic.-mV10rc9fE.jpg 1.5x,/w/images/1/11/xTor_browser_duckduckgo2.jpg.pagespeed.ic.4nRs8mKmto.jpg 2x\" height=\"555\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"1016\"/>\n</div>\n</section>\n<section class=\"showcase\" id=\"applications\" style=\"background-image: url(/w/images/b/bd/6C3FA495.jpg);\">\n<div class=\"showcase-index\">\n<div>\n<h2>Applications are reviewed and pre-configured.</h2>\n</div>\n<ul class=\"showcase-grid\">\n<li class=\"\"><a href=\"wiki/Tor_Browser\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/3/3a/Torbrowser_icon.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Tor Browser</a></li>\n<li class=\"\"><a href=\"wiki/OnionShare\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/d/de/Onionshare_logo.png.pagespeed.ce.8A0eBYtf-K.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>OnionShare</a></li>\n<li class=\"\"><a href=\"wiki/Encrypted_Email_with_Thunderbird_and_Enigmail\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/b/b1/Thunderbird256.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Thunderbird</a></li>\n<li class=\"\"><a href=\"wiki/Passwords\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/5/51/KeePassXC.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>KeePassXC</a></li>\n<li class=\"\"><a href=\"wiki/HexChat\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/7/7b/Hexchaticon.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>HexChat</a></li>\n<li class=\"\"><a href=\"wiki/Software#Media_Player\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/c/cd/2000px-VLC_Icon.svg.png/64px-2000px-VLC_Icon.svg.png\" height=\"72\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>VLC</a></li>\n<li class=\"\"><a href=\"wiki/Software#Terminal\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/c/c2/Utilities-terminal.png.pagespeed.ce.ODBiRRiRHy.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Terminal</a></li>\n<li class=\"\"><a href=\"wiki/Electrum\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/6/63/64x58xElectrum-appimage.png.pagespeed.ic.SOYx2LB5YZ.png\" data-pagespeed-lazy-srcset=\"/w/images/6/63/96x87xElectrum-appimage.png.pagespeed.ic.qexJpjjS7v.png 1.5x,/w/images/6/63/Electrum-appimage.png 2x\" height=\"58\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Electrum</a></li>\n<li class=\"\"><a href=\"wiki/Bitcoin\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/2/29/BC_Logo_.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Bitcoin</a></li>\n<li class=\"\"><a href=\"wiki/Monero\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/0/05/Monero-symbol-1280.png.pagespeed.ce.BuuX90NoOR.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Monero</a></li>\n</ul>\n</div>\n</section>\n<section class=\"features\" id=\"features\">\n<div class=\"grid\">\n<div class=\"two-thirds\">\n<h2>Fully Featured and Advanced Security Features</h2>\n</div>\n</div>\n<div class=\"grid\">\n<div class=\"third\">\n<a href=\"w/images/d/dd/Whonix_concept_refined.jpg\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Leak IP Address\" data-pagespeed-lazy-src=\"/w/images/d/dd/xWhonix_concept_refined.jpg.pagespeed.ic.khtMqOJ7jr.jpg\" height=\"430\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"799\"/>\n</a>\n<h4>Impossible to leak IP address</h4>\n<p>\nConnections are forced through Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a>. DNS leaks are impossible, and\neven malware with root privileges cannot discover the user's real IP\naddress. Leak tested through <a href=\"https://github.com/Whonix/corridor\" title=\"Corridor\">corridor</a> (Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a> traffic whitelisting gateway) and other <a href=\"wiki/Dev/Leak_Tests\">leak tests</a>.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"w/images/b/bf/Live_boot.png\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Live Mode\" data-pagespeed-lazy-src=\"/w/images/0/09/xLive_boot_cropped_more.jpeg.pagespeed.ic.JJNbza3cU7.jpg\" height=\"86\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"446\"/>\n</a>\n<h4>Live Mode</h4>\n<p>\nBooting into <a href=\"wiki/Whonix_Live\" rel=\"noopener\" target=\"_blank\">Live Mode</a> is a simple as choosing Live Mode in the boot menu.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Kicksecure\" data-pagespeed-lazy-src=\"/w/images/5/52/Hardening-13423213.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"240\"/>\n<h4>Based on Kicksecure ™</h4>\n<p>\nWhonix <a href=\"wiki/Whonix_Trademark_Policy\" rel=\"noopener\" target=\"_blank\">™</a> is based on <a href=\"wiki/Kicksecure\" rel=\"noopener\" target=\"_blank\">Kicksecure</a> ™ which is a a security-hardened Linux distribution.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"w/images/f/fb/Htw2.png\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Tor\" data-pagespeed-lazy-src=\"/w/images/thumb/f/fb/Htw2.png/250x160x446px-Htw2.png.pagespeed.ic.NW-0HkWVNn.png\" data-pagespeed-lazy-srcset=\"/w/images/thumb/f/fb/Htw2.png/375x240x446px-Htw2.png.pagespeed.ic.l9C2_a7QYs.png 1.5x,/w/images/thumb/f/fb/Htw2.png/x446px-Htw2.png.pagespeed.ic.iNgmkgGkZF.png 2x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"250\"/>\n</a>\n<h4>Based on Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a></h4>\n<p>\nWhonix <a href=\"wiki/Whonix_and_Tor\" rel=\"noopener\" target=\"_blank\">utilizes</a> Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a>, which provides an open and distributed relay network to defend against network surveillance.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://github.com/vmonaco/kloak#try-it-out\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"kloak\" data-pagespeed-lazy-src=\"/w/images/d/d6/160x160xTrain-normal_test-kloak.png.pagespeed.ic.AqB2c2KKeT.png\" data-pagespeed-lazy-srcset=\"/w/images/d/d6/Train-normal_test-kloak.png 1.5x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"160\"/>\n</a>\n<h4>Keystroke Anonymization</h4>\n<p>\n<a href=\"wiki/Keystroke_Deanonymization\" rel=\"noopener\" target=\"_blank\">Keystrokes</a> can be used to track users. To prevent this, Whonix comes with <a href=\"wiki/Keystroke_Deanonymization#Kloak\" rel=\"noopener\" target=\"_blank\">kloak</a> installed by default.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"wiki/Dev/TimeSync\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"time\" data-pagespeed-lazy-src=\"/w/images/0/04/Carriage-clock-797833640.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"240\"/>\n</a>\n<h4>Time Attack Defenses</h4>\n<p>\n<a href=\"wiki/Time_Attacks\" rel=\"noopener\" target=\"_blank\">Time attacks</a> are defeated by\n<a href=\"wiki/Boot_Clock_Randomization\" rel=\"noopener\" target=\"_blank\">Boot Clock Randomization</a>\nand secure network time synchronization\nthrough <a href=\"wiki/sdwdate\" rel=\"noopener\" target=\"_blank\">sdwdate</a> (Secure Distributed Web Date).\n</p>\n</div>\n<div class=\"third\">\n<a href=\"wiki/vanguards\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"vanguards\" data-pagespeed-lazy-src=\"/w/images/f/fd/158x160xVanguard.png.pagespeed.ic.p_zzbTACX3.png\" data-pagespeed-lazy-srcset=\"/w/images/f/fd/237x240xVanguard.png.pagespeed.ic.ncqXQHr_0V.png 1.5x,/w/images/f/fd/316x320xVanguard.png.pagespeed.ic.GXcY2QtMrY.png 2x,/w/images/f/fd/474x480xVanguard.png.pagespeed.ic.0jEBM9rdce.png 3x,/w/images/f/fd/xVanguard.png.pagespeed.ic.yCgrTZPUvM.png 4.399x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"158\"/>\n</a>\n<h4>Protect against guard discovery and related traffic analysis attacks</h4>\n<p>\n<a href=\"wiki/vanguards\">vanguards</a>\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://github.com/Whonix/tirdad\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"tirdad\" data-pagespeed-lazy-src=\"/w/images/f/f0/240x160xResized_tirdad2.jpg.pagespeed.ic.imLBYWkNzv.jpg\" data-pagespeed-lazy-srcset=\"/w/images/f/f0/360x240xResized_tirdad2.jpg.pagespeed.ic.QKOpAae4ZM.jpg 1.5x,/w/images/f/f0/480x320xResized_tirdad2.jpg.pagespeed.ic.YMT2qrzncm.jpg 2x,/w/images/f/f0/720x480xResized_tirdad2.jpg.pagespeed.ic.Zz6af61I9y.jpg 3x,/w/images/f/f0/xResized_tirdad2.jpg.pagespeed.ic.AMnvQXqRmz.jpg 16.32x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"240\"/>\n</a>\n<h4>TCP ISN CPU Information Leak Protection</h4>\n<p>\nPrevent <a class=\"external text\" href=\"https://dl.acm.org/citation.cfm?id=1180410\" rel=\"noreferrer noopener\" target=\"_blank\">de-anonymization of Tor onion services</a> through <a class=\"external text\" href=\"https://github.com/Whonix/tirdad\" rel=\"noreferrer noopener\" target=\"_blank\">Tirdad kernel module for random ISN generation</a>.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"entropy\" data-pagespeed-lazy-src=\"/w/images/f/fb/Random_entropy_background_removed.png.pagespeed.ce.wDppJw-Dh9.png\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"160\"/>\n<h4>Entropy Enhancements</h4>\n<p>\nBetter encryption thanks to <a href=\"wiki/Dev/Entropy\" rel=\"noopener\" target=\"_blank\">preinstalled</a> random number generators.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"w/images/f/fc/Stream_isolation.1.0.jpg\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Stream Isolation\" data-pagespeed-lazy-src=\"/w/images/f/fc/124x160xStream_isolation.1.0.jpg.pagespeed.ic.YdcccFFBBx.jpg\" data-pagespeed-lazy-srcset=\"/w/images/f/fc/186x240xStream_isolation.1.0.jpg.pagespeed.ic.hGxTShoCtB.jpg 1.5x,/w/images/f/fc/248x320xStream_isolation.1.0.jpg.pagespeed.ic.GRqzTRpF1j.jpg 2x,/w/images/f/fc/372x480xStream_isolation.1.0.jpg.pagespeed.ic.Qo459wAADF.jpg 3x,/w/images/f/fc/xStream_isolation.1.0.jpg.pagespeed.ic.4TO8RNKOlL.jpg 5.976x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"124\"/>\n</a>\n<h4>Stream Isolation</h4>\n<p>\nDistinct applications are routed through different paths in the Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a> network.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"wiki/AppArmor\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"AppArmor\" data-pagespeed-lazy-src=\"/w/images/thumb/3/3f/2000px-AppArmor_logo.svg.png/705px-2000px-AppArmor_logo.svg.png\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"160\"/>\n</a>\n<h4>AppArmor</h4>\n<p>\n<a href=\"wiki/AppArmor\" rel=\"noopener\" target=\"_blank\">AppArmor</a> profiles restrict the capabilities of commonly used, high-risk applications.\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://github.com/Whonix/security-misc\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"security-misc\" data-pagespeed-lazy-src=\"/w/images/7/7b/Overlord59-tux-halo.png\" height=\"135\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"135\"/>\n</a>\n<h4>Kernel Self Protection Settings</h4>\n<p>\nWhonix uses <a href=\"https://github.com/Whonix/security-misc\" rel=\"noopener\" target=\"_blank\">Kernel Hardening Settings</a> as recommended by the Kernel Self Protection Project (KSPP).\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://github.com/Whonix/security-misc\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/d/d7/Franck-v-_E1PQXKUkMw-unsplash.jpg/241x160x361px-Franck-v-_E1PQXKUkMw-unsplash.jpg.pagespeed.ic.huDiVtwTM-.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/d/d7/Franck-v-_E1PQXKUkMw-unsplash.jpg/x361px-Franck-v-_E1PQXKUkMw-unsplash.jpg.pagespeed.ic.jLN0OEg1Lf.jpg 1.5x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"241\"/>\n</a>\n<h4>Protect Linux user accounts against brute force attacks</h4>\n<p>\n<a href=\"https://github.com/Whonix/security-misc\" rel=\"noopener\" target=\"_blank\">By using pam tally2.</a>\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://github.com/Whonix/security-misc\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"security-misc\" data-pagespeed-lazy-src=\"/w/images/d/d1/Oshardening34234.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"240\"/>\n</a>\n<h4>Strong Linux User Account Separation</h4>\n<p>\n<a href=\"https://github.com/Whonix/security-misc\" rel=\"noopener\" target=\"_blank\">security-misc</a>\n</p>\n</div>\n<div class=\"third\">\n<a href=\"https://github.com/Whonix/anon-apps-config\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"anon-apps-config\" data-pagespeed-lazy-src=\"/w/images/6/61/Preferences_system.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n</a>\n<h4>Anonymity, privacy and security settings pre-configuration</h4>\n<p>\n<a href=\"https://github.com/Whonix/anon-apps-config\" rel=\"noopener\" target=\"_blank\">anon-apps-config</a>\n</p>\n</div>\n<div class=\"third\">\n<a href=\"wiki/Documentation\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Documentation\" data-pagespeed-lazy-src=\"/w/images/thumb/5/55/Advanceddocumentation213123.jpg/240x160x300px-Advanceddocumentation213123.jpg.pagespeed.ic.jfqyJ4GSEx.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/5/55/Advanceddocumentation213123.jpg/x300px-Advanceddocumentation213123.jpg.pagespeed.ic.bOnyfBW93C.jpg 1.5x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"240\"/>\n</a>\n<h4>Extensive Documentation</h4>\n<p>\n<a href=\"wiki/Documentation\" rel=\"noopener\" target=\"_blank\">The more you know, the safer you can be.</a>\n</p>\n</div>\n<div class=\"third\">\n<a href=\"wiki/Anbox\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"anbox\" data-pagespeed-lazy-src=\"/w/images/1/1f/Anbox.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"209\"/>\n</a>\n<h4>Android Support</h4>\n<p>\nRun Android applications using\n<a href=\"wiki/Anbox\" rel=\"noopener\" target=\"_blank\">Anbox</a> (outdated) or\n<a href=\"wiki/Other_Operating_Systems#Whonix-Android-Workstation\" rel=\"noopener\" target=\"_blank\">Whonix-Custom-Workstation using Android x86</a>.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Virus Protection\" data-pagespeed-lazy-src=\"/w/images/c/cf/Shield.png\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"160\"/>\n<h4>Virus Protection</h4>\n<p>\nAdditional security hardening measures and user education through Whonix provide better protection from <a href=\"wiki/Malware\" rel=\"noopener\" target=\"_blank\">viruses</a>.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Console Lockdown\" data-pagespeed-lazy-src=\"/w/images/thumb/7/74/Console-lockdown.jpg/284x160x800px-Console-lockdown.jpg.pagespeed.ic.BA92SSvsz2.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/7/74/Console-lockdown.jpg/426x240x800px-Console-lockdown.jpg.pagespeed.ic.Mu90qhb24A.jpg 1.5x,/w/images/thumb/7/74/Console-lockdown.jpg/568x320x800px-Console-lockdown.jpg.pagespeed.ic.QtaXGIBTsM.jpg 2x,/w/images/thumb/7/74/Console-lockdown.jpg/x800px-Console-lockdown.jpg.pagespeed.ic.VTtbXSWsUu.jpg 3x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"284\"/>\n<h4>Console Lockdown</h4>\n<p>\n<a href=\"wiki/Dev/Strong_Linux_User_Account_Isolation#Console_Lockdown\" rel=\"noopener\" target=\"_blank\">\nConsole Lockdown\n</a> disables legacy login methods for improved security hardening.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Advanced Firewall\" data-pagespeed-lazy-src=\"/w/images/5/52/Firewall-29940640.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"287\"/>\n<h4>Advanced Firewall</h4>\n<p>Configured for anonymous Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a> use.</p>\n</div>\n<div class=\"third\">\n<a href=\"w/images/b/b8/Tor_browser_youtube.jpeg\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"YouTube\" data-pagespeed-lazy-src=\"/w/images/thumb/b/b8/Tor_browser_youtube.jpeg/293x160x470px-Tor_browser_youtube.jpeg.pagespeed.ic.xOIX2ux4jq.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/b/b8/Tor_browser_youtube.jpeg/439x240x470px-Tor_browser_youtube.jpeg.pagespeed.ic.hSWDlMJwmX.jpg 1.5x,/w/images/thumb/b/b8/Tor_browser_youtube.jpeg/x470px-Tor_browser_youtube.jpeg.pagespeed.ic.ekjz5tJ45G.jpg 2x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"293\"/>\n</a>\n<h4>Tor<a href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\" rel=\"noopener\" target=\"_blank\">®</a> Browser</h4>\n<p>Visit any destination including modern websites such as YouTube.</p>\n</div>\n<div class=\"third\">\n<img alt=\"YouTube\" data-pagespeed-lazy-src=\"/w/images/thumb/9/91/Encrypted-156514_1280.png/150px-Encrypted-156514_1280.png\" height=\"164\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"150\"/>\n<h4>swap-file-creator</h4>\n<p>Running low on RAM isn't a security problem. <a href=\"https://github.com/Whonix/swap-file-creator\" rel=\"noopener\" target=\"_blank\">swap-file-creator</a>\nwill create an encrypted swap file.</p>\n</div>\n<div class=\"third\">\n<img alt=\"server\" data-pagespeed-lazy-src=\"/w/images/thumb/0/07/Computer_n_screen.png/200px-Computer_n_screen.png\" height=\"207\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"200\"/>\n<h4>Hosting Location Hidden Servers</h4>\n<p>Whonix is the safest way to host <a href=\"wiki/Onion_Services\" rel=\"noopener\" target=\"_blank\">Onion Services</a>.</p>\n</div>\n<div class=\"third\">\n<img alt=\"Forums and more\" data-pagespeed-lazy-src=\"/w/images/c/cf/Discourse_logo.svg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"157\"/>\n<h4>Vibrant Community</h4>\n<p>\n<a class=\"read-more\" href=\"https://forums.whonix.org\" rel=\"noopener\" target=\"_blank\">\nForums </a>\n<br/>\n<a class=\"read-more\" href=\"https://t.me/Whonix_Chat_No_Media\" rel=\"noopener\" target=\"_blank\">\nTelegram </a><br/>\n<a class=\"read-more\" href=\"https://matrix.to/#/!ldUrkJMMqFScVZBdYN:tchncs.de?via=matrix.org&amp;via=tchncs.de&amp;via=privacytools.io\" rel=\"noopener\" target=\"_blank\">\nMatrix </a><br/>\n<a class=\"read-more\" href=\"https://mailman.whonix.org/postorius/lists/whonix-newsletter.mailman.whonix.org/\" rel=\"noopener\" target=\"_blank\">\nNewsletter </a><br/>\n<a class=\"read-more\" href=\"wiki/Contributors\" rel=\"noopener\" target=\"_blank\">\nContributors\n</a>\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"History\" data-pagespeed-lazy-src=\"/w/images/thumb/a/a3/Jon-tyson-FlHdnPO6dlw-unsplash.jpg/120x160x187px-Jon-tyson-FlHdnPO6dlw-unsplash.jpg.pagespeed.ic._EkV_nijc4.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/a/a3/Jon-tyson-FlHdnPO6dlw-unsplash.jpg/180x240x187px-Jon-tyson-FlHdnPO6dlw-unsplash.jpg.pagespeed.ic.5iyOttJw2A.jpg 1.5x,/w/images/thumb/a/a3/Jon-tyson-FlHdnPO6dlw-unsplash.jpg/187px-Jon-tyson-FlHdnPO6dlw-unsplash.jpg 2x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"120\"/>\n<h4>History</h4>\n<p>\nAn eight year <a href=\"wiki/History\" rel=\"noopener\" target=\"_blank\">history</a>\nof protecting our users against\n<a href=\"wiki/Security_in_Real_World\" rel=\"noopener\" target=\"_blank\">Real World Attacks.</a>\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Fully Auditable\" data-pagespeed-lazy-src=\"/w/images/thumb/4/44/Bho78-4ycp0.jpg/241x160x362px-Bho78-4ycp0.jpg.pagespeed.ic._pk8RyfukS.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/4/44/Bho78-4ycp0.jpg/361x240x362px-Bho78-4ycp0.jpg.pagespeed.ic.0czvwus-ap.jpg 1.5x,/w/images/thumb/4/44/Bho78-4ycp0.jpg/362px-Bho78-4ycp0.jpg 2x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"241\"/>\n<h4>Fully auditable</h4>\n<p>\nYou don’t have to trust our word that it respects and protects you.\nIt is independently verifiable by security experts and software\ndevelopers around the world.\n<a href=\"wiki/Why_Whonix_is_Freedom_Software\" rel=\"noopener\" target=\"_blank\">\nThis improves security and privacy for everyone.\n</a>\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"privacy\" data-pagespeed-lazy-src=\"/w/images/thumb/9/93/Hunters-race-MYbhN8KaaEc-unsplash.jpg/705px-Hunters-race-MYbhN8KaaEc-unsplash.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"240\"/>\n<h4>Complete respect for privacy</h4>\n<p>\nYour data always belongs to you, and only you. We don’t make advertising deals or collect sensitive personal data. We’re funded directly by our users paying what they want. And that’s how it should be.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Canary\" data-pagespeed-lazy-src=\"/w/images/thumb/2/2c/Zdenek-machacek-OlKkCmToXEs-unsplash.jpg/470px-Zdenek-machacek-OlKkCmToXEs-unsplash.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"117\"/>\n<h4>Warrant Canary</h4>\n<p>\nA <a href=\"wiki/Trust#canary\" rel=\"noopener\" target=\"_blank\">canary</a>\nconfirms that no warrants have been served on the Whonix project.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Debian\" data-pagespeed-lazy-src=\"/w/images/3/30/Debian.png\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"130\"/>\n<h4>Based on Debian</h4>\n<p>\nIn oversimplified terms, Whonix is just a collection of configuration files and scripts. Whonix is not a stripped down version of Debian; anything possible in \"vanilla\" Debian GNU/Linux can be replicated in Whonix.\n<a href=\"wiki/About\" rel=\"noopener\" target=\"_blank\">About Whonix</a>\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"Freedom\" data-pagespeed-lazy-src=\"/w/images/thumb/2/28/Neonbrand-lJ6iASrFAnQ-unsplash.jpg/470px-Neonbrand-lJ6iASrFAnQ-unsplash.jpg\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"107\"/>\n<h4>Complete user freedom</h4>\n<p>\nThere are no artificial restrictions on how users can reconfigure the system.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"signed\" data-pagespeed-lazy-src=\"/w/images/e/e4/Iconfinder_gpg_6334.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n<h4>Digitally signed releases</h4>\n<p>\nDownloads are <a href=\"wiki/Verifying_Software_Signatures\" rel=\"noopener\" target=\"_blank\">signed</a> so you can <a href=\"wiki/Verify_the_Whonix_images\" rel=\"noopener\" target=\"_blank\">verify</a> they are genuine Whonix releases.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"GNU\" data-pagespeed-lazy-src=\"/w/images/a/a3/164x160xHeckert_gnu.big.png.pagespeed.ic.TLOOgoZTCx.png\" data-pagespeed-lazy-srcset=\"/w/images/a/a3/246x240xHeckert_gnu.big.png.pagespeed.ic.MLfW35tRyt.png 1.5x,/w/images/a/a3/328x320xHeckert_gnu.big.png.pagespeed.ic.Hh7qzmcpZT.png 2x,/w/images/a/a3/Heckert_gnu.big.png 3x\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"164\"/>\n<h4>Freedom Software</h4>\n<p>\nWhonix is\n<a href=\"https://forums.whonix.org/t/lets-call-it-freedom-software-rather-than-free-software-or-open-source/6961\" rel=\"noopener\" target=\"_blank\">Freedom Software</a>\nand contains software developed by the\n<a href=\"https://www.fsf.org/\" rel=\"noopener\" target=\"_blank\">Free Software Foundation</a>\nand the\n<a href=\"https://www.gnu.org\" rel=\"noopener\" target=\"_blank\">GNU Project</a>.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"OpenSource\" data-pagespeed-lazy-src=\"/w/images/thumb/0/09/Osi_standard_logo_0.png/470px-Osi_standard_logo_0.png\" height=\"160\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"133\"/>\n<h4>Open Source</h4>\n<p>\nAll of <a href=\"https://github.com/Whonix\" rel=\"noopener\" target=\"_blank\">Whonix source code</a> is\n<a href=\"wiki/Whonix:Copyrights#License\" rel=\"noopener\" target=\"_blank\">licensed</a>\nunder <a href=\"https://opensource.org/licenses/\" rel=\"noopener\" target=\"_blank\">OSI Approved Licenses</a>. We respect the rights of our users. All of Whonix is available for review, scrutiny, modification, and redistribution by anyone. This improves security and privacy for everyone.\n</p>\n</div>\n<div class=\"third\">\n<img alt=\"research\" data-pagespeed-lazy-src=\"/w/images/thumb/7/7f/Cornues.png/128px-Cornues.png\" height=\"135\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>\n<h4><a href=\"wiki/What_we_do\" title=\"Research\">Research</a> and Implementation Project </h4>\n<p>\nBe wary of those confidently calling themselves all-knowing, all-perfect. Whonix is an actively maintained research project making constant improvements -- no <a href=\"wiki/Warning\" title=\"Warning\">shortcomings</a> are ever hidden from users.\n</p>\n</div>\n</div>\n</section>\n<section class=\"features\" id=\"security\" style=\"background-color: #273445; color: white;\">\n<div class=\"grid\">\n<div class=\"two-thirds\">\n<h2>Upcoming Security Enhancements</h2>\n</div>\n</div>\n<div class=\"grid\">\n<div class=\"third\">\n<h4>\n<img alt=\"LKRG\" data-pagespeed-lazy-src=\"/w/images/thumb/a/a7/P_lkrg2.png/349x200x800px-P_lkrg2.png.pagespeed.ic.IfT0uEk1VM.png\" data-pagespeed-lazy-srcset=\"/w/images/thumb/a/a7/P_lkrg2.png/523x300x800px-P_lkrg2.png.pagespeed.ic.Eb0O6l64WX.png 1.5x,/w/images/thumb/a/a7/P_lkrg2.png/800px-P_lkrg2.png 2x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"349\"/>\n<a class=\"whitelink\" href=\"wiki/Linux_Kernel_Runtime_Guard_LKRG\" rel=\"noopener\" target=\"_blank\">\nLinux Kernel Runtime Guard (LKRG)\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/7/79/Mandatoryaccesscontrol.jpg/352x200x800px-Mandatoryaccesscontrol.jpg.pagespeed.ic.P5c-hQPlfD.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/7/79/Mandatoryaccesscontrol.jpg/528x300x800px-Mandatoryaccesscontrol.jpg.pagespeed.ic.FFFfd_41EC.jpg 1.5x,/w/images/thumb/7/79/Mandatoryaccesscontrol.jpg/704x400x800px-Mandatoryaccesscontrol.jpg.pagespeed.ic.Oh5Zol9ou0.jpg 2x,/w/images/thumb/7/79/Mandatoryaccesscontrol.jpg/x800px-Mandatoryaccesscontrol.jpg.pagespeed.ic.AqkW2-p8Lo.jpg 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"352\"/>\n<a class=\"whitelink\" href=\"https://github.com/Whonix/apparmor-profile-everything\" rel=\"noopener\" target=\"_blank\">\nFull system Mandatory Access Control (MAC) policy - \"AppArmor for everything\"\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/5/53/Untrustedrootaccess.jpg/300x200x800px-Untrustedrootaccess.jpg.pagespeed.ic.5bolYG5nGY.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/5/53/Untrustedrootaccess.jpg/450x300x800px-Untrustedrootaccess.jpg.pagespeed.ic.O9K9DSv1IC.jpg 1.5x,/w/images/thumb/5/53/Untrustedrootaccess.jpg/600x400x800px-Untrustedrootaccess.jpg.pagespeed.ic.ROnt1ypIKo.jpg 2x,/w/images/thumb/5/53/Untrustedrootaccess.jpg/x800px-Untrustedrootaccess.jpg.pagespeed.ic._dRdRc4uO1.jpg 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"300\"/>\n<a class=\"whitelink\" href=\"https://forums.whonix.org/t/untrusted-root-does-it-make-sense-to-try-to-improve-security-by-restricting-root/7998\" rel=\"noopener\" target=\"_blank\">\nUntrusted Root User\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/e/e1/Verifykernel.png/137x200x411px-Verifykernel.png.pagespeed.ic.6aSvVnuwxS.png\" data-pagespeed-lazy-srcset=\"/w/images/thumb/e/e1/Verifykernel.png/205x300x411px-Verifykernel.png.pagespeed.ic.6odBQGrVgX.png 1.5x,/w/images/thumb/e/e1/Verifykernel.png/274x400x411px-Verifykernel.png.pagespeed.ic.TutRbYrdn6.png 2x,/w/images/thumb/e/e1/Verifykernel.png/411px-Verifykernel.png 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"137\"/>\n<a class=\"whitelink\" href=\"https://forums.whonix.org/t/allow-loading-signed-kernel-modules-by-default-disallow-kernel-module-loading-by-default/7880\" rel=\"noopener\" target=\"_blank\">\nenforce kernel module software signature verification\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/d/da/xText_x_patch.png.pagespeed.ic.wsVPHuoGIA.png\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"200\"/>\n<a class=\"whitelink\" href=\"wiki/Dev/VirusForget\" rel=\"noopener\" target=\"_blank\">\ndeactivate malware after reboot from non-root compromise\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/6/6d/Hardenkernel.jpg/x800px-Hardenkernel.jpg.pagespeed.ic.ji00IFgWxr.jpg\" height=\"533\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"800\"/>\n<a class=\"whitelink\" href=\"https://github.com/Whonix/hardened-kernel\" rel=\"noopener\" target=\"_blank\">\nHardened Linux Kernel\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/9/90/Postquantum.jpg/267x200x800px-Postquantum.jpg.pagespeed.ic.Z8Fwzti-3r.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/9/90/Postquantum.jpg/400x300x800px-Postquantum.jpg.pagespeed.ic.kVD-pF2mWi.jpg 1.5x,/w/images/thumb/9/90/Postquantum.jpg/534x400x800px-Postquantum.jpg.pagespeed.ic.CoRDuGdx2m.jpg 2x,/w/images/thumb/9/90/Postquantum.jpg/x800px-Postquantum.jpg.pagespeed.ic.wlbcNItWzR.jpg 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"267\"/>\n<a class=\"whitelink\" href=\"https://forums.whonix.org/t/use-codecrypt-to-sign-whonix-releases/7844/2\" rel=\"noopener\" target=\"_blank\">\npost-quantum cryptography resistant signing of releases\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/7/7b/Mountoptions.jpg/300x200x800px-Mountoptions.jpg.pagespeed.ic.C2wUdhIYKp.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/7/7b/Mountoptions.jpg/450x300x800px-Mountoptions.jpg.pagespeed.ic.1wDGTxxSgy.jpg 1.5x,/w/images/thumb/7/7b/Mountoptions.jpg/600x400x800px-Mountoptions.jpg.pagespeed.ic.AaVCyyUm8a.jpg 2x,/w/images/thumb/7/7b/Mountoptions.jpg/x800px-Mountoptions.jpg.pagespeed.ic.7VOBCL1BCo.jpg 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"300\"/>\n<a class=\"whitelink\" href=\"https://forums.whonix.org/t/re-mount-home-and-other-with-noexec-and-nosuid-among-other-useful-mount-options-for-better-security/7707\" rel=\"noopener\" target=\"_blank\">\nMount Options Hardening\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/e/ed/Disablesuidbinary.jpg/284x200x800px-Disablesuidbinary.jpg.pagespeed.ic.RX1nF_P8vw.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/e/ed/Disablesuidbinary.jpg/426x300x800px-Disablesuidbinary.jpg.pagespeed.ic.vJGHYK4PV5.jpg 1.5x,/w/images/thumb/e/ed/Disablesuidbinary.jpg/568x400x800px-Disablesuidbinary.jpg.pagespeed.ic.a2EP_X0UhQ.jpg 2x,/w/images/thumb/e/ed/Disablesuidbinary.jpg/x800px-Disablesuidbinary.jpg.pagespeed.ic.DA1qWbU3I_.jpg 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"284\"/>\n<a class=\"whitelink\" href=\"https://forums.whonix.org/t/disable-suid-binaries/7706\" rel=\"noopener\" target=\"_blank\">\nDisable SUID Binaries\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/7/7c/Multipleboot.jpg/300x200x800px-Multipleboot.jpg.pagespeed.ic.RWk_eQYeZY.jpg\" data-pagespeed-lazy-srcset=\"/w/images/thumb/7/7c/Multipleboot.jpg/450x300x800px-Multipleboot.jpg.pagespeed.ic.mmCGsIFtrM.jpg 1.5x,/w/images/thumb/7/7c/Multipleboot.jpg/600x400x800px-Multipleboot.jpg.pagespeed.ic.dOGTwfzmLU.jpg 2x,/w/images/thumb/7/7c/Multipleboot.jpg/x800px-Multipleboot.jpg.pagespeed.ic.tjLGKCtF2E.jpg 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"300\"/>\n<a class=\"whitelink\" href=\"https://forums.whonix.org/t/multiple-boot-modes-for-better-security-persistent-root-persistent-noroot-live-root-live-noroot/7708\" rel=\"noopener\" target=\"_blank\">\nmultiple boot modes for better security (user, live, secureadmin, superadmin)\n</a>\n</h4>\n</div>\n<div class=\"third\">\n<h4>\n<img alt=\"\" data-pagespeed-lazy-src=\"/w/images/0/07/193x200xComputer_n_screen.png.pagespeed.ic.T_hKzB5aUU.png\" data-pagespeed-lazy-srcset=\"/w/images/0/07/289x300xComputer_n_screen.png.pagespeed.ic.iZ1Uqmr4wa.png 1.5x,/w/images/0/07/386x400xComputer_n_screen.png.pagespeed.ic.PpgPS0mcep.png 2x,/w/images/0/07/Computer_n_screen.png 3x\" height=\"200\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"193\"/>\n<a class=\"whitelink\" href=\"wiki/Contribute\" rel=\"noopener\" target=\"_blank\">\nHelp welcome!\n</a>\n</h4>\n</div>\n</div>\n</section>\n<section class=\"showcase\" id=\"compatibility\" style=\"background-image: url(/w/images/b/bd/6C3FA495.jpg);\">\n<div class=\"showcase-index\">\n<div>\n<h2>Compatibility</h2>\n</div>\n<ul class=\"showcase-grid\">\n<li class=\"\"><a href=\"wiki/VirtualBox\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/d/d5/Virtualbox_logo.png/64x64x100px-Virtualbox_logo.png.pagespeed.ic.6RCjFkVOlA.png\" data-pagespeed-lazy-srcset=\"/w/images/thumb/d/d5/Virtualbox_logo.png/100px-Virtualbox_logo.png 1.5x\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>VirtualBox</a></li>\n<li class=\"\"><a href=\"wiki/KVM\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/thumb/b/bb/Kvm.png/150px-Kvm.png\" height=\"128\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"128\"/>KVM</a></li>\n<li class=\"\"><a href=\"wiki/Qubes\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/9/94/64x64xQubes-logo-blue.png.pagespeed.ic.xi0gYN5XfM.png\" data-pagespeed-lazy-srcset=\"/w/images/9/94/96x96xQubes-logo-blue.png.pagespeed.ic.gfM4u4rUs_.png 1.5x,/w/images/9/94/128x128xQubes-logo-blue.png.pagespeed.ic.a6YF-Lpo5-.png 2x,/w/images/9/94/Qubes-logo-blue.png 3x\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Qubes OS</a></li>\n<li class=\"\"><a href=\"wiki/Debian\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/3/30/Debian.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Debian</a></li>\n<li class=\"\"><a href=\"wiki/Ubuntu\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/b/be/Logo-ubuntusvg.png\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Ubuntu®</a></li>\n<li class=\"\"><a href=\"wiki/MacOS\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/3/36/64x64xMacos_by_ego_no_background.png.pagespeed.ic.z7sRQYw-aE.png\" data-pagespeed-lazy-srcset=\"/w/images/3/36/96x96xMacos_by_ego_no_background.png.pagespeed.ic.M4Mdmw7hYg.png 1.5x,/w/images/3/36/Macos_by_ego_no_background.png.pagespeed.ce.NdNGvU9byj.png 2x\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>macOS</a></li>\n<li class=\"\"><a href=\"wiki/Windows_Quick_Start\" rel=\"noopener\" target=\"_blank\"><img alt=\"\" data-pagespeed-lazy-src=\"/w/images/e/ee/64x64xWindows_logo_-_2012.svg.png.pagespeed.ic.b7iDh4fpTW.png\" data-pagespeed-lazy-srcset=\"/w/images/e/ee/Windows_logo_-_2012.svg.png 1.5x\" height=\"64\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"64\"/>Windows</a></li>\n</ul>\n</div>\n</section>\n<section class=\"security\" id=\"investors\">\n<div class=\"app-display app-display--overflow\">\n<img alt=\"Investors\" class=\"app-display__image\" data-pagespeed-lazy-src=\"/w/images/b/b8/xProfessional12313.jpg.pagespeed.ic.L89sZPtMBv.jpg\" height=\"443\" onerror=\"this.onerror=null;pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" onload=\"pagespeed.lazyLoadImages.loadIfVisibleAndMaybeBeacon(this);\" src=\"pagespeed_static/1.JiBnMqyl6S.gif\" width=\"640\"/>\n<div class=\"app-display__description\">\n<h2>Investors</h2>\n<h4>\nInterested in becoming an investor? See\n<a href=\"wiki/Investors\" rel=\"noopener\" target=\"_blank\">Project Metrics</a>.\n</h4>\n</div>\n</div>\n</section>\n<footer>\nWant to improve this page? Help is welcome and volunteer contributions are happily considered! Read, understand and agree to\n<a href=\"wiki/Whonix:Copyrights#Conditions_for_Contributions_to_Whonix_.E2.84.A2\" rel=\"noopener\" target=\"_blank\">Conditions for Contributions to Whonix ™</a>\n, then edit\n<a href=\"https://github.com/Whonix/Whonix-Website\" rel=\"noopener\" target=\"_blank\">whonix.org frontpage wiki source code</a>!<br/>\n<br/>\nWhonix <a href=\"wiki/Whonix_Trademark_Policy\" rel=\"noopener\" target=\"_blank\">™</a> is produced independently from the Tor<a class=\"read-more\" href=\"https://2019.www.torproject.org/docs/trademark-faq.html.en\">®</a> anonymity software and carries no guarantee from <a class=\"read-more\" href=\"https://www.torproject.org\">The Tor Project</a> about quality, suitability or anything else.\n<ul>\n<li id=\"footer-Imprint\">\n<a href=\"wiki/Imprint\" title=\"Imprint\">Imprint</a>\n</li>\n<li id=\"footer-Privacy_Policy\">\n<a href=\"wiki/Privacy_Policy\" title=\"Privacy Policy\">Privacy Policy</a>\n</li>\n<li id=\"footer-Cookie_Policy\">\n<a href=\"wiki/Cookie_Policy\" title=\"Cookie Policy\">Cookie Policy</a>\n</li>\n<li id=\"footer-Terms_of_Service\">\n<a href=\"wiki/Terms_of_Service\" title=\"Terms of Service\">Terms of Service</a>\n</li>\n<li id=\"footer-DMCA\">\n<a class=\"mw-redirect\" href=\"wiki/DMCA\" title=\"DMCA\">DMCA</a>\n</li>\n<li id=\"footer-E_Sign_Consent\">\n<a href=\"wiki/E-Sign_Consent\" title=\"E-Sign Consent\">E-Sign Consent</a>\n</li>\n<li id=\"footer-Priority_Support\">\n<a href=\"wiki/Priority_Support\" title=\"Priority Support\">Priority Support</a>\n</li>\n<li id=\"footer-Investors\">\n<a href=\"wiki/Investors\" title=\"Investors\">Investors</a>\n</li>\n<li id=\"footer-Professional_Support\">\n<a href=\"wiki/Professional_Support\" title=\"Professional Support\">Professional Support</a>\n</li>\n</ul>\n</footer>\n<noscript class=\"psa_add_styles\"><link href=\"A.home.css.pagespeed.cf.RuRJvA3aLS.css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/></noscript><script data-pagespeed-no-defer=\"\" type=\"text/javascript\">pagespeed.lazyLoadImages.overrideAttributeFunctions();</script><script data-pagespeed-no-defer=\"\">(function(){function b(){var a=window,c=e;if(a.addEventListener)a.addEventListener(\"load\",c,!1);else if(a.attachEvent)a.attachEvent(\"onload\",c);else{v