  "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">\n\n<html>\n<head>\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-type\"/>\n<meta content=\"UK Guns and ammo store, buy guns and ammo on the deep web with bitcoin at our Tor store.\" name=\"description\">\n<link href=\"favicon.ico\" rel=\"icon\" type=\"image/icon\"/>\n<link href=\"favicon.ico\" rel=\"shortcut icon\" type=\"image/icon\"/>\n<title>UK Guns and Ammo Store - Buy guns and ammo in the UK for Bitcoin.</title>\n<style type=\"text/css\">\r\nbody{background-color: #E9E9E9;\r\n\tbackground-image:url(background.png);\r\n\tfont:14px Arial,Sans-serif;\r\n\tmargin:0;\r\n\tpadding:0;}\r\n\r\nimg {border:0;}\r\n\r\n.floatimg {padding-bottom:5px; padding-right:20px;}\r\n\r\nh3 {color:#333; font: bold 28px/1em HelveticaNeue, Arial, sans-serif; margin: 5px 0 20px 2px;}\r\n\r\n#header {\r\n\twidth:892px;\r\n\theight:82px;\r\n\tposition: absolute;\r\n\tleft: 50%;\r\n\tmargin-left:-446px;\r\n\tmargin-top: -100px;\r\n\tmargin-bottom: 0px;\r\n\tz-index:4;\r\n\tbackground-color: #464646;\r\n    -webkit-border-radius: 0 0 7px 7px;\r\n\t-moz-border-radius: 0 0 7px 7px;\r\n\tborder-radius: 0 0 7px 7px;}\r\n\r\n#logo { height:82px;width:892px;}\r\n\r\n#logo img{\r\n    -webkit-border-radius: 0 0 7px 7px;\r\n\t-moz-border-radius: 0 0 7px 7px;\r\n\tborder-radius: 0 0 7px 7px;}\r\n\r\n/* Menu */\r\n.menu, .menu ul {margin:5px 0;padding:0;list-style:none;}\r\n.menu li, .menu ul a {position:relative;}\r\n.menu > li {float:left;}\r\n.menu > li.floatr {float:right;}\r\n.menu li > a {display:block;}\r\n.menu ul {position:absolute; display:none; width:125px;}\r\n.menu ul ul {top:0; left:125px;}\r\n.menu > li.floatr > ul {right:0;}\r\n.menu > li.floatr > ul ul {left:-125px;}\r\n.menu li:hover > ul {display:block;}\r\n\r\n.menu {\r\n\theight:32px;\r\n\tborder:1px solid #b2b2b2;\r\n\tfont-family:Arial, Helvetica, sans-serif;\r\n\tbackground-color:#d4d4d4;\r\n\tbackground-image:-webkit-linear-gradient(top, #e0e0e0, #c8c8c8);\r\n\tbackground-image:-moz-linear-gradient(top, #e0e0e0, #c8c8c8);\r\n\tbackground-image:-o-linear-gradient(top, #e0e0e0, #c8c8c8);\r\n\tbackground-image:-ms-linear-gradient(top, #e0e0e0, #c8c8c8);\r\n\tbackground-image:linear-gradient(top, #e0e0e0, #c8c8c8);\r\n\t-webkit-border-radius:3px;\r\n\t-moz-border-radius:3px;\r\n\tborder-radius:3px;\r\n\t-webkit-box-shadow:inset 0 1px #f4f4f4, inset 0 -1px #b3b3b3, 0 1px 3px #ddd;\r\n\t-moz-box-shadow:inset 0 1px #f4f4f4, inset 0 -1px #b3b3b3, 0 1px 3px #ddd;\r\n\tbox-shadow:inset 0 1px #f4f4f4, inset 0 -1px #b3b3b3, 0 1px 3px #ddd;}\r\n\r\n.menu a {text-decoration:none;}\r\n.menu > li > a {\r\n\tcolor:#444;\r\n\tfont-weight:bold;\r\n\tfont-size:12px;\r\n\tline-height:16px;\r\n\ttext-shadow:0 1px #f8f8f8;\r\n\tpadding:8px 12px 8px;}\r\n.menu > li:hover > a {\r\n\tbackground-color:#fff;\r\n\tbackground-image:-webkit-linear-gradient(top, #f5f5f5, #fff);\r\n\tbackground-image:-moz-linear-gradient(top, #f5f5f5, #fff);\r\n\tbackground-image:-o-linear-gradient(top, #f5f5f5, #fff);\r\n\tbackground-image:-ms-linear-gradient(top, #f5f5f5, #fff);\r\n\tbackground-image:linear-gradient(top, #f5f5f5, #fff);\t\r\n\t-webkit-box-shadow:inset 0 3px #eee;\r\n\t-moz-box-shadow:inset 0 3px #eee;\r\n\tbox-shadow:inset 0 3px #eee;\t\r\n\tborder-left:none;\r\n\tpadding-left:13px;}\r\n\r\n.menu > li {border-right:1px solid #bbb;border-right:1px solid rgba(10, 10, 10, .1);}\r\n.menu > li > a {border-left:1px solid #e3e3e3;border-left:1px solid rgba(255, 255, 255, .35);}\r\n.menu > li.floatr {border-right:none;border-left:1px solid #bbb;border-left:1px solid rgba(10, 10, 10, .1);}\r\n\r\n.menu > li > a .bubble-top {\r\n\tposition:absolute;\r\n\tfont-size:11px;\r\n\tline-height:14px;\r\n\tcolor:#fff;\r\n\tpadding:0 3px;\r\n\tright:4px;\r\n\ttop:-8px;\r\n\ttext-shadow:none;\r\n\tborder:1px solid #a00000;\r\n\t-webkit-border-radius:3px;\r\n\t-moz-border-radius:3px;\r\n\tborder-radius:2px;\r\n\