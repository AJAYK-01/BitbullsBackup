-radius:2px;display:block;margin:0 auto;position:relative;height:10em}.security{display:-ms-flexbox;display:flex;-ms-flex-pack:center;justify-content:center;max-width:100%;padding:48px 0;position:relative;background-color:#273445;color:#fff}.security a{color:#8cd5ff}.security img{max-height:80vh}.security .app-display__description h2{text-align:left}.security .app-display__description h4{margin-top:1em}.tbb{display:-ms-flexbox;display:flex;-ms-flex-pack:center;justify-content:center;padding:0;width:100%;background-color:#273445;color:#fff}.app-display__image{padding:2em;max-width:70%}@media (min-width:1000px){#tbb .app-display__image{width:67%;-ms-flex-order:0;order:0}}#download{background-color:#273445;color:#fff;padding:1em 1em}#download a{color:#fff}#download img{height:8em;margin-right:.25em;vertical-align:middle}#download .third p{font-size:.8em}footer li{float:left;width:10em}footer a{color:#000}#whonix-dekstop-pic{max-width:90%}a.freelink{background-color:green;color:#fff;padding:.25em;text-decoration:none;text-transform:uppercase;font-weight:bold}a.whitelink{color:#fff;padding:.25em;font-weight:bold}</style>\n<title>Whonix - Software That Can Anonymize Everything You Do Online</title>\n<script data-pagespeed-no-defer=\"\">(function(){function f(a,b,d){if(a.addEventListener)a.addEventListener(b,d,!1);else if(a.attachEvent)a.attachEvent(\"on\"+b,d);else{var c=a[\"on\"+b];a[\"on\"+b]=function(){d.call(this);c&&c.call(this)}}};window.pagespeed=window.pagespeed||{};var g=window.pagespeed;function k(a){this.g=[];this.f=0;this.h=!1;this.j=a;this.i=null;this.l=0;this.b=!1;this.a=0}function l(a,b){var d=b.getAttribute(\"data-pagespeed-lazy-position\");if(d)return parseInt(d,0);var d=b.offsetTop,c=b.offsetParent;c&&(d+=l(a,c));d=Math.max(d,0);b.setAttribute(\"data-pagespeed-lazy-position\",d);return d}\nfunction m(a,b){var d,c,e;if(!a.b&&(0==b.offsetHeight||0==b.offsetWidth))return!1;a:if(b.currentStyle)c=b.currentStyle.position;else{if(document.defaultView&&document.