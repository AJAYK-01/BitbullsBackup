t src=\"http://snovzruogrfrh252.onion/wp-includes/js/jquery/ui/widget.min.js?ver=1.11.4\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-includes/js/jquery/ui/mouse.min.js?ver=1.11.4\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-includes/js/jquery/ui/draggable.min.js?ver=1.11.4\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/wp-live-chat-support/js/wplc_pro_features.js?ver=8.1.4\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/wp-live-chat-support/js/wplc_u_pro_events.js?ver=8.1.4\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/wp-live-chat-support/js/wplc_u_editor.js?ver=8.1.4\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/woocommerce/assets/js/jquery-blockui/jquery.blockUI.min.js?ver=2.70\" type=\"text/javascript\"></script>\n<script type=\"text/javascript\">\n/* <![CDATA[ */\nvar wc_add_to_cart_params = {\"ajax_url\":\"\\/wp-admin\\/admin-ajax.php\",\"wc_ajax_url\":\"\\/?wc-ajax=%%endpoint%%\",\"i18n_view_cart\":\"View cart\",\"cart_url\":\"http:\\/\\/snovzruogrfrh252.onion\\/cart\\/\",\"is_cart\":\"\",\"cart_redirect_after_add\":\"no\"};\n/* ]]> */\n</script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/woocommerce/assets/js/frontend/add-to-cart.min.js?ver=3.8.0\" type=\"text/javascript\"></script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/woocommerce/assets/js/js-cookie/js.cookie.min.js?ver=2.1.4\" type=\"text/javascript\"></script>\n<script type=\"text/javascript\">\n/* <![CDATA[ */\nvar woocommerce_params = {\"ajax_url\":\"\\/wp-admin\\/admin-ajax.php\",\"wc_ajax_url\":\"\\/?wc-ajax=%%endpoint%%\"};\n/* ]]> */\n</script>\n<script src=\"http://snovzruogrfrh252.onion/wp-content/plugins/woocommerce/assets/js/frontend/woocommerce.min.js?ver=