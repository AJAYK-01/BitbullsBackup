e=\"books\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"20419-21053\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 15\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit16\" id=\"social_networks\">Social networks</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://blkbook3fxhcsn3u.onion/\" rel=\"nofollow\" title=\"http://blkbook3fxhcsn3u.onion/\">BlackBook</a></strong> - Social media site (The facebook of TOR)\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://w363zoq3ylux5rf5.onion/\" rel=\"nofollow\" title=\"http://w363zoq3ylux5rf5.onion/\">Galaxy 2</a></strong> - A revival of the old Galaxy community\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"https://www.facebookcorewwwi.onion/\" rel=\"nofollow\" title=\"https://www.facebookcorewwwi.onion/\">Facebook</a></strong> - The real Facebook’s Onion domain. Claim not to keep logs. Trust them at your peril\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://imwkdn62pvr6jueo.onion/\" rel=\"nofollow\" title=\"http://imwkdn62pvr6jueo.onion/\">MultiVerse Social Network</a></strong> - Social Network with anonymous <abbr title=\"Internet Relay Chat\">IRC</abbr> chat services as well as other features\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://3cgcpd6bz3gbuhrn.onion/\" rel=\"nofollow\" title=\"http://3cgcpd6bz3gbuhrn.onion/\">Friendica</a></strong> - The friend network\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://society44nlbxqdz.onion/\" rel=\"nofollow\" title=\"http://society44nlbxqdz.onion/\">Public timeline</a></strong> - society\n</p>\n</div>\n<div class=\"secedit editbutton_section editbutton_16\"><form action=\"/doku.php\" class=\"button btn_secedit\" method=\"post\"><div class=\"no\"><input name=\"do\" type=\"hidden\" value=\"edit\"/><input name=\"rev\" type=\"hidden\" value=\"1596392367\"/><input name=\"summary\" type=\"hidden\" value=\"[section 16] \"/><input name=\"target\" type=\"hidden\" value=\"section\"/><input name=\"hid\" type=\"hidden\" value=\"social_networks\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"21054-21638\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 16\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit17\" id=\"french_francais\">French / Français</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://libertygb2nyeyay.onion/\" rel=\"nofollow\" title=\"http://libertygb2nyeyay.onion/\">Liberty's Hackers</a></strong> - No CP, No racism - because Knowledge has value only if it is shared by all - hosting service\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://libertygb2nyeyay.onion/wiki/\" rel=\"nofollow\" title=\"http://libertygb2nyeyay.onion/wiki/\">Liberty's Hackers &amp; French Deep Web Wiki</a></strong> - Liberty's Hackers &amp; French Deep Web Wiki - sharing everything.\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://fdwocbsnity6vzwd.onion/\" rel=\"nofollow\" title=\"http://fdwocbsnity6vzwd.onion/\">French Deep Web</a></strong> - an administered and moderate French board (1er forum francophone)\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://trollodrome2.torpress2sarn7xw.onion/forum/forum-non-modere/\" rel=\"nofollow\" title=\"http://trollodrome2.torpress2sarn7xw.onion/forum/forum-non-modere/\">Trollodrôme</a></strong> - Forum non modéré\n</p>\n</div>\n<div class=\"secedit editbutton_section editbutton_17\"><form action=\"/doku.php\" class=\"button btn_secedit\" method=\"post\"><div class=\"no\"><input name=\"do\" type=\"hidden\" value=\"edit\"/><input name=\"rev\" type=\"hidden\" value=\"1596392367\"/><input name=\"summary\" type=\"hidden\" value=\"[section 17] \"/><input name=\"target\" type=\"hidden\" value=\"section\"/><input name=\"hid\" type=\"hidden\" value=\"french_francais\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"21639-21821\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 17\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit18\" id=\"german_deutsch\">German / Deutsch</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://konkretzdxpqygow.onion/\" rel=\"nofollow\" title=\"http://konkretzdxpqygow.onion/\">Konkret</a></strong> - das linke Magazin: Archiv.\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://qj3m7wxqk4pfqwob.onion/\" rel=\"nofollow\" title=\"http://qj3m7wxqk4pfqwob.onion/\">MadIRC</a></strong> - Deutscher <abbr title=\"Internet Relay Chat\">IRC</abbr>-Channel.\n</p>\n</div>\n<div class=\"secedit editbutton_section editbutton_18\"><form action=\"/doku.php\" class=\"button btn_secedit\" method=\"post\"><div class=\"no\"><input name=\"do\" type=\"hidden\" value=\"edit\"/><input name=\"rev\" type=\"hidden\" value=\"1596392367\"/><input name=\"summary\" type=\"hidden\" value=\"[section 18] \"/><input name=\"target\" type=\"hidden\" value=\"section\"/><input name=\"hid\" type=\"hidden\" value=\"german_deutsch\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"21822-22156\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 18\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit19\" id=\"italian_italiano\">Italian / Italiano</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://blackhost5xlrhev.onion/\" rel=\"nofollow\" title=\"http://blackhost5xlrhev.onion/\">BlackHost</a></strong> - A small website developed by an Italian programmer\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://xodijruknc2fcsyj.onion\" rel=\"nofollow\" title=\"http://xodijruknc2fcsyj.onion\">New System Disorder</a></strong> - Italian Hackers Community - Stay Tuned!\n</p>\n<p>\n<strong><a class=\"urlextern\" href=\"http://2qrdpvonwwqnic7j.onion/\" rel=\"nofollow\" title=\"http://2qrdpvonwwqnic7j.onion/\">IDC Reloaded</a></strong> - Italian DarkNet Community - Canale <abbr title=\"Internet Relay Chat\">IRC</abbr>\n</p>\n</div>\n<div class=\"secedit editbutton_section editbutton_19\"><form action=\"/doku.php\" class=\"button btn_secedit\" method=\"post\"><div class=\"no\"><input name=\"do\" type=\"hidden\" value=\"edit\"/><input name=\"rev\" type=\"hidden\" value=\"1596392367\"/><input name=\"summary\" type=\"hidden\" value=\"[section 19] \"/><input name=\"target\" type=\"hidden\" value=\"section\"/><input name=\"hid\" type=\"hidden\" value=\"italian_italiano\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"22157-22374\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 19\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit20\" id=\"japanese_日本語\">Japanese / 日本語</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://xiwayy2kn32bo3ko.onion\" rel=\"nofollow\" title=\"http://xiwayy2kn32bo3ko.onion\">|OnionChannel</a></strong> - Onion Channel, a system similar to 2channel.\n<strong><a class=\"urlextern\" href=\"http://poverty4657tlx6h.onion\" rel=\"nofollow\" title=\"http://poverty4657tlx6h.onion\">Japan Hidden Wiki</a></strong> - Links to Japan onions.\n</p>\n</div>\n<div class=\"secedit editbutton_section editbutton_20\"><form action=\"/doku.php\" class=\"button btn_secedit\" method=\"post\"><div class=\"no\"><input name=\"do\" type=\"hidden\" value=\"edit\"/><input name=\"rev\" type=\"hidden\" value=\"1596392367\"/><input name=\"summary\" type=\"hidden\" value=\"[section 20] \"/><input name=\"target\" type=\"hidden\" value=\"section\"/><input name=\"hid\" type=\"hidden\" value=\"japanese_日本語\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"22375-22538\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 20\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit21\" id=\"korean_한국어\">Korean / 한국어</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://zqktlwi4fecvo6ri.onion/wiki/Korean_Hidden_Wiki\" rel=\"nofollow\" title=\"http://zqktlwi4fecvo6ri.onion/wiki/Korean_Hidden_Wiki\">Korean Hidden Wiki</a></strong> - 한국어 히든 위키 페이지입니다\n</p>\n</div>\n<div class=\"secedit editbutton_section editbutton_21\"><form action=\"/doku.php\" class=\"button btn_secedit\" method=\"post\"><div class=\"no\"><input name=\"do\" type=\"hidden\" value=\"edit\"/><input name=\"rev\" type=\"hidden\" value=\"1596392367\"/><input name=\"summary\" type=\"hidden\" value=\"[section 21] \"/><input name=\"target\" type=\"hidden\" value=\"section\"/><input name=\"hid\" type=\"hidden\" value=\"korean_한국어\"/><input name=\"codeblockOffset\" type=\"hidden\" value=\"0\"/><input name=\"range\" type=\"hidden\" value=\"22539-22640\"/><input name=\"id\" type=\"hidden\" value=\"start\"/><button title=\"section 21\" type=\"submit\">Edit</button></div></form></div>\n<h2 class=\"sectionedit22\" id=\"chinese_中国語\">Chinese / 中国語</h2>\n<div class=\"level2\">\n<hr/>\n<p>\n<strong><a class=\"urlextern\" href=\"http://almvdkg6vrpmkvk4.onion\" rel=\"nofollow\" title=\"http://almvdkg6vrpmkvk4.onion\">中文论坛</a></strong> - 中文论坛\n</p>\n</div>\n<!-- wikipage stop -->\n</div>\n<div class=\"docInfo\"><bdi>start.txt</bdi> · Last modified: 2020/08/02 21:19 (external edit)</div>\n</div></div><!-- /content -->\n<hr class=\"a11y\"/>\n<!-- PAGE ACTIONS -->\n<div id=\"dokuwiki__pagetools\">\n<h3 class=\"a11y\">Page Tools</h3>\n<div class=\"tools\">\n<ul>\n<li class=\"top\"><a accesskey=\"t\" href=\"#dokuwiki__top\" rel=\"nofollow\" title=\"Back to top [t]\"><span>Back to top</span><svg height=\"24\" viewbox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M13 20h-2V8l-5.5 5.5-1.42-1.42L12 4.16l7.92 7.92-1.42 1.42L13 8v12z\"></path></svg></a></li> </ul>\n</div>\n</div>\n</div><!-- /wrapper -->\n<!-- ********** FOOTER ********** -->\n<div id=\"dokuwiki__footer\"><div class=\"pad\">\n<div class=\"license\">Except where otherwise noted, content on this wiki is licensed under the following license: <bdi><a class=\"urlextern\" href=\"http://creativecommons.org/licenses/by-sa/4.0/\" rel=\"license\">CC Attribution-Share Alike 4.0 International</a></bdi></div>\n<div class=\"buttons\">\n<a href=\"http://creativecommons.org/licenses/by-sa/4.0/\" rel=\"license\"><img alt=\"CC Attribution-Share Alike 4.0 International\" src=\"/lib/images/license/button/cc-by-sa.png\"/></a> <a href=\"https://www.dokuwiki.org/donate\" title=\"Donate\"><img alt=\"Donate\" height=\"15\" src=\"/lib/tpl/dokuwiki/images/button-donate.gif\" width=\"80\"/></a>\n<a href=\"https://php.net\" title=\"Powered by PHP\"><img alt=\"Powered by PHP\" height=\"15\" src=\"/lib/tpl/dokuwiki/images/button-php.gif\" width=\"80\"/></a>\n<a href=\"//validator.w3.org/check/referer\" title=\"Valid HTML5\"><img alt=\"Valid HTML5\" height=\"15\" src=\"/lib/tpl/dokuwiki/images/button-html5.png\" width=\"80\"/></a>\n<a href=\"//jigsaw.w3.org/css-validator/check/referer?profile=css3\" title=\"Valid CSS\"><img alt=\"Valid CSS\" height=\"15\" src=\"/lib/tpl/dokuwiki/images/button-css.png\" width=\"80\"/></a>\n<a href=\"https://dokuwiki.org/\" title=\"Driven by DokuWiki\"><img alt=\"Driven by DokuWiki\" height=\"15\" src=\"/lib/tpl/dokuwiki/images/button-dw.png\" width=\"80\"/></a>\n</div>\n</div></div><!-- /footer -->\n</div></div><!-- /site -->\n<div class=\"no\"><img alt=\"\" height=\"1\" src=\"/lib/exe/indexer.php?id=start&amp;1596900523\" width=\"2\"/></div>\n<div class=\"no\" id=\"screen__mode\"></div></body>\n</html>\n",
