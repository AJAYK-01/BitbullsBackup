  "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">\n\n<html>\n<head>\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-type\"/>\n<link href=\"favicon.ico\" rel=\"icon\" type=\"image/icon\"/>\n<link href=\"favicon.ico\" rel=\"shortcut icon\" type=\"image/icon\"/>\n<title>TomAndJerry - Extremely stealth shipping from the netherlands! </title>\n<style type=\"text/css\">\r\nbody {\r\nbackground:#FFF;\r\ncolor:#000;\r\nmargin:0;\r\npadding:0\r\n}\r\n\r\nbody,.buttn,.txt,textarea,#menu a {\r\nfont:13px Verdana,Tahoma,serif\r\n}\r\n\r\ndiv {\r\nposition:relative\r\n}\r\n\r\n:focus {\r\noutline:none\r\n}\r\n\r\n::-moz-focus-inner {\r\nborder:0\r\n}\r\n\r\n#menu {\r\nheight:30px;\r\nmargin-bottom:21px;\r\nwidth:515px\r\n}\r\n\r\n#menu a,.buttn {\r\nbackground:#395379;\r\nborder:2px outset #395379;\r\ncolor:#FFF;\r\ncursor:pointer;\r\nfont-weight:700\r\n}\r\n\r\n#menu a:hover,#menu a:focus,.buttn:hover,.buttn:focus {\r\nbackground:#222;\r\nborder-color:#222\r\n}\r\n\r\n#menu a {\r\nfloat:left;\r\nmargin-right:4px;\r\npadding:5px 8px\r\n}\r\n\r\n#menu a:focus {\r\npadding:5px 7px 5px 9px\r\n}\r\n\r\n#menu a,.buttn,.txt,textarea,.table1 td,.table1 th,.floatimg {\r\n-moz-border-radius:10px;\r\n-webkit-border-radius:10px;\r\nborder-radius:10px\r\n}\r\n\r\n#logo {\r\nheight:60px;\r\nleft:50%;\r\nmargin-left:93px;\r\nposition:absolute;\r\nwidth:332px\r\n}\r\n\r\n#main {\r\n-moz-border-radius:15px;\r\n-webkit-border-radius:15px;\r\nborder:3px dotted #D5DDEB;\r\nborder-radius:15px;\r\nmargin:20px auto 30px;\r\npadding:16px 20px 0;\r\nwidth:850px\r\n}\r\n\r\n.buttn {\r\nheight:30px\r\n}\r\n\r\n.buttn,#menu a,.txt,textarea,.floatimg {\r\n-moz-box-shadow:2px 2px 2px rgba(0,0,0,0.333);\r\n-webkit-box-shadow:2px 2px 2px rgba(0,0,0,0.333);\r\nbox-shadow:2px 2px 2px rgba(0,0,0,0.333);\r\n}\r\n\r\n.txt {\r\nheight:24px;\r\nmargin:4px 0;\r\ntext-align:center\r\n}\r\n\r\ntextarea {\r\noverflow:auto;\r\npadding:8px\r\n}\r