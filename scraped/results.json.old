!-- end container -->\n</div><!-- end topbar -->\n<header class=\"header bordertop\" data-offset-bottom=\"200\" data-offset-top=\"60\" data-spy=\"affix\" id=\"headeraffix\">\n<div class=\"container\">\n<div class=\"row mb-5\">\n<div class=\"col-md-12\">\n<nav class=\"yamm navbar navbar-default\" role=\"navigation\">\n<div class=\"container-fluid\">\n<div class=\"navbar-table\">\n<div class=\"navbar-cell tight\">\n<div class=\"navbar-header\">\n<a class=\"navbar-brand\" href=\"index.html\"><img alt=\"CC KINGDOM\" src=\"images/logo.png\"/></a>\n<div>\n<button class=\"navbar-toggle collapsed\" data-target=\"#bs-example-navbar-collapse-2\" data-toggle=\"collapse\" type=\"button\">\n<span class=\"sr-only\">Toggle navigation</span>\n<span class=\"fa fa-bars\"></span>\n</button>\n</div>\n</div><!-- end navbar-header -->\n</div><!-- end navbar-cell -->\n<div class=\"navbar-cell stretch\">\n<div class=\"collapse navbar-collapse\" id=\"bs-example-navbar-collapse-2\">\n<div class=\"navbar-cell\">\n<ul class=\"nav navbar-nav navbar-right\">\n<li><a href=\"index.html\">HOME</a></li>\n<li><a href=\"buy-cc.html\">BUY CREDIT CARD</a></li>\n<li><a href=\"buy-paypal.html\" title=\"\">BUY PAYPAL</a></li>\n<li><a href=\"photos.html\" title=\"\">PHOTOS</a></li>\n<li><a href=\"faqs.html\" title=\"\">FAQS</a></li>\n<li><a href=\"contact-about.html\" title=\"\">CONTACT &amp; ABOUT US</a></li>\n</ul>\n</div></div></div></div></div></nav></div></div></div></header></body></html>\n\n<!-- end navbar-cell -->\n<!-- /.navbar-collapse -->\n<!-- end navbar cell -->\n<!-- end navbar-table -->\n<!-- end container fluid -->\n<!-- end navbar -->\n<!-- end col -->\n<!-- end row -->\n<!-- end container -->\n\n<section class=\"slider-section\">\n<div class=\"tp-banner-container\">\n<img alt=\"CC KINGDOM TOP BANNER\" src=\"images/cckingdom-home-top.jpg\" style=\"width: 100%; max-height: auto;\">\n</img></div>\n</section>\n<section class=\"section white\">\n<div class=\"container\">\n<div class=\"section-title text-center\">\n<h4>Our Services</h4>\n<hr/>\n<h3>Prepaid Credit Cards &amp; PayPal Accounts</h3>\n</div><!-- end title -->\n<div class=\"row text-center\">\n<div class=\"col-md-6 col-sm-6\">\n<div class=\"service-style-1 withborder wow fadeIn\">\n<img alt=\"cc kingdom prepaid credit cards service\" src=\"images/cc-kingdom-credit-card-service.png\" style=\"max-width: 100%; max-height: auto;\"/><br/><br/><br/>\n<h4>Prepaid USD ($) / EUR (€) Credit Cards</h4>\n<p style=\"font-size:16px\">Our cards come with Chip <font color=\"#FFD700\">(See Photos)</font> and PIN Code. You can choose between USD or EUR card and the company of the prepaid card: Visa or Mastercard. The cards work all over the world and the currency is automatically converted to the local currency of the country in which you live</p>\n<div class=\"button-wrapper text-center\">\n<a class=\"btn btn-primary border-radius btn-lg btn-dark\" href=\"buy-cc.html\">ORDER NOW</a>\n</div><!-- end button wrapper -->\n</div><!-- end service -->\n</div><!-- end col -->\n<div class=\"col-md-6 col-sm-6\">\n<div class=\"service-style-1 withborder wow fadeIn\">\n<img alt=\"cc kingdom paypal accounts service\" src=\"images/cc-kingdom-paypal-service.png\" style=\"max-width: 100%; max-height: auto;\"/><br/><br/><br/>\n<h4>PayPal USD ($) / EUR (€) Accounts</h4>\n<p style=\"font-size:16px\">You will receive a aged PayPal account with the amount you selected - <font color=\"#FFD700\">(No withdrawal / transfer restrictions from the account!)</font> + New dedicated Socks5 proxy  + 2018 PayPal to BTC / CC / BANK Method (You can choose that our team convert from PayPal to Bitcoin for additional cost of 70$)</p>\n<div class=\"button-wrapper text-center\">\n<a class=\"btn btn-primary border-radius btn-lg btn-dark\" href=\"buy-paypal.html\">ORDER NOW</a>\n</div><!-- end button wrapper -->\n</div><!-- end service -->\n</div><!-- end col -->\n</div><!-- end row -->\n</div><!-- end container -->\n</section><!-- end section -->\n<section class=\"section fullscreen paralbackground parallax\" data-diff=\"100\" data-img-height=\"525\" data-img-width=\"1600\" style=\"background-image:url('images/cc-kingdom-credit-cards-photos-background.jpg');\">\n<div class=\"container\">\n<div class=\"section-title text-center\">\n<h4>photos</h4>\n<hr/>\n<h3>real proofs!</h3>\n</div><!-- end title -->\n<ul class=\"portfolio-grid portfolio-gallery-3 clearfix masonry\" id=\"portfolio-grid\">\n<li class=\"portfolio-item mix cat1 cat2 cat3\">\n<div class=\"portfolio-style-1 entry wow fadeIn\" data-wow-delay=\"0.2s\" data-wow-duration=\"1s\">\n<img alt=\"\" src=\"upload/kingdom-cckingdomtmf7w7l-photo-10.jpg\" style=\"width: 100%; max-height: auto;\"/>\n<div class=\"magnifier\">\n<div class=\"visible-title\">\n</div><!-- end visible-title -->\n<div class=\"visible-title1 clearfix\">\n<span class=\"pull-left\">\n<a data-rel=\"prettyPhoto\" href=\"upload/big-pics/kingdom-cckingdomtmf7w7l-photo-10-big.jpg\" style=\"width: 100%; max-height: auto;\"><i class=\"fa fa-search\"></i></a>\n</span>\n<span class=\"pull-right\">\n</span>\n</div><!-- end visible-title -->\n</div><!-- end magnifier -->\n</div><!-- end portfolio -->\n</li>\n<li class=\"portfolio-item mix cat1 cat2 cat3\">\n<div class=\"portfolio-style-1 entry wow fadeIn\" data-wow-delay=\"0.2s\" data-wow-duration=\"1s\">\n<img alt=\"\" src=\"upload/kingdom-cckingdomtmf7w7l-photo-2.jpg\" style=\"width: 100%; max-height: auto;\"/>\n<div class=\"magnifier\">\n<div class=\"visible-title\">\n</div><!-- end visible-title -->\n<div class=\"visible-title1 clearfix\">\n<span class=\"pull-left\">\n<a data-rel=\"prettyPhoto\" href=\"upload/big-pics/kingdom-cckingdomtmf7w7l-photo-2-big.jpg\" style=\"width: 100%; max-height: auto;\"><i class=\"fa fa-search\"></i></a>\n</span>\n<span class=\"pull-right\">\n</span>\n</div><!-- end visible-title -->\n</div><!-- end magnifier -->\n</div><!-- end portfolio -->\n</li>\n<li class=\"portfolio-item mix cat1 cat2 cat3\">\n<div class=\"portf