  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">\n\n<html>\n<head>\n<title>The Paypal Cent!</title>\n<link href=\"css/style.css\" rel=\"stylesheet\" type=\"text/css\"/>\n</head>\n<body>\n<table align=\"center\" style=\"height: 100%;\" width=\"100%\">\n<td style=\"background-image:url('images/background2.jpg');\" valign=\"top\">\n<div><a href=\"index.php\"><img border=\"0\" src=\"images/ppcentsmall.png\" style=\"float:left;\"/></a>\n<div class=\"mainmenu\" style=\"float:left;\"><b>\n<ul id=\"navlist\" style=\"display: inline-block;\">\n<li><a href=\"index.php\">Home</a></li>\n<li><a href=\"aboard.php\">Board</a></li>\n<li><a href=\"faq.php\">FAQ</a></li>\n<li><a href=\"rules.php\">Rules</a></li>\n<li><a href=\"feedback.php\">Feedback</a></li>\n<li><a href=\"contact.php\">Contact / Manual</a></li>\n</ul></b>\n<dhr width=\"100%\">\n</dhr></div>\n</div>\n<div style=\"clear:both\">\n<hr align=\"left\" width=\"95%\"/>\n</div>\n<div style=\"text-align: center;\"><br/>\n<br/>\n<a href=\"aboard.php\"><img src=\"images/ppcent.png\"/></a><br/><br/><br/>\n<p>\n<font color=\"#01325a\" face=\"Verdana\" size=\"5\">Welcome to the greatest place on TOR!</font>\n<p>\n<br/><font color=\"#01325a\" size=\"4\"><b>Site News</b></font>\n<center>\n<div style=\"text-align:left;padding:5px;font-size:16px;color:#0369b7;width:80%;border: 1px dashed grey;border-radius:5px;\">\n<li><b>07/18/2020</b>: <b>New accounts</b> has arrived today, feel free to look.\n            <p>\n<li><b>08/04/2020</b>: It is always a nice job reading your honest feedbacks, because we're not doing\n                    this service just for the profit, we're also making people happy here. That said, we updated the <a href=\"feedback.php\"><b>Feedback page</b></a> with some of your comments we liked the most. :)\n                    Don't get us wrong, all feedbacks are welcome, we are grateful for every single one of them. But\n                    here are our current favourites. :)\n            <p>\n<li><b>07/26/2020</b>: We have some <b>fresh new accounts</b> today, we hope it will satisfy you again.\n                    :)\n            <p>\n<!--<li><b>01/25/2017</b>: We have an important message against some false allegations about our system. Please <b><a href=\"faq.php#tips\">click here</a></b> to read it. Thank you!<p>-->\n</p></li></p></li></p></li></div>\n</center>\n<p> \n\n        <p>\n<font size=\"4\"><b><font color=\"#404040\">We are always on.<br/></font> <font color=\"#0071c0\">No</font></b> waiting\n                for an operator, <b><font color=\"#0071c0\">no </font></b>explaining of yourself.<br/>We have made this\n                service <b><font color=\"#0071c0\">automatic</font></b>, and it's here <b><font color=\"#0071c0\">24/7</font></b>.</font>\n<p> \n\n        <p>\n<font size=\"4\">Please read the <a href=\"faq.php\"><span style=\"font-weight: bold;\">FAQ</span></a> first, and check our <a href=\"aboard.php\"><span style=\"font-weight: bold;\">current board</span></a>!</font></p></p></p></p></p></p></div></td></table></body></html>\n\n\n",
